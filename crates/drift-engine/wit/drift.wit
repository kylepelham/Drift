package drift:plugin@0.2.0;

/// What Drift tells a plugin and what it may answer. JSON travels as strings:
/// a tool's input is whatever shape the tool takes.
interface types {
    record tool-call {
        session-id: string,
        workspace: string,
        agent: string,
        tool: string,
        /// The tool's input as JSON.
        input: string,
    }

    variant before-tool {
        allow,
        /// The call does not run; the model is told why.
        deny(string),
        /// The call runs with this JSON input instead.
        replace(string),
    }

    record tool-result {
        session-id: string,
        workspace: string,
        agent: string,
        tool: string,
        input: string,
        /// What the model will read, up to the engine's bound.
        output: string,
        /// The tool errored, or a shell command exited non-zero.
        failed: bool,
    }

    variant after-tool {
        keep,
        /// The model reads this instead.
        replace(string),
        /// One line under the output, shown as "<plugin>: <note>"; cut at 160 characters.
        note(string),
    }

    /// The user's prompt, before the model sees it.
    record prompt {
        session-id: string,
        workspace: string,
        agent: string,
        text: string,
    }

    variant prompt-submit {
        keep,
        /// The model reads this text instead of the user's.
        replace(string),
        /// Added beside the prompt as context from the plugin; the user sees it too.
        add-context(string),
        /// The prompt is not sent; the user is told why.
        deny(string),
    }

    /// The model's reply that ended a turn.
    record reply {
        session-id: string,
        workspace: string,
        agent: string,
        text: string,
    }

    variant turn-end {
        accept,
        /// The turn ends; the line is shown under the reply as the plugin's, and the model never sees it.
        note(string),
        /// The turn goes on: the reason is sent to the model as a prompt from the plugin.
        continue(string),
    }

    /// A call the rules would ask the user about.
    record permission-ask {
        session-id: string,
        workspace: string,
        agent: string,
        tool: string,
        /// The rule namespace: `bash`, `edit`, `read`, `webfetch`, `mcp`, ...
        kind: string,
        /// What is touched: a path, a command line, a URL.
        pattern: string,
        title: string,
        /// For a shell line, the simple commands it runs; absent when the line hides what it runs.
        commands: option<list<string>>,
    }

    variant permission {
        /// Not the plugin's call: the user is asked as usual.
        pass,
        allow,
        /// The call does not run; the model is told why.
        deny(string),
    }

    /// A conversation about to be summarised.
    record compaction {
        session-id: string,
        workspace: string,
        agent: string,
    }

    variant compacting {
        proceed,
        /// Added to the summariser's instructions, so the summary keeps what the plugin needs.
        instruct(string),
    }

    enum session-kind {
        created,
        running,
        idle,
        updated,
        deleted,
        /// Its history was summarised.
        compacted,
    }

    record session {
        id: string,
        workspace: string,
        title: string,
        agent: string,
    }
}

interface host {
    enum level { info, warn, error }
    log: func(level: level, message: string);
    /// The plugin's own object from its drift.json entry, as JSON; "{}" when none.
    config: func() -> string;
}

/// The plugin's own values, kept by Drift across runs.
interface store {
    get: func(key: string) -> option<string>;
    set: func(key: string, value: string);
}

/// Files under the workspace of the event being handled; nothing outside it.
interface files {
    read: func(path: string) -> result<string, string>;
    write: func(path: string, content: string) -> result<_, string>;
}

/// A program run in the event's workspace, with its output bounded.
interface process {
    record output {
        code: s32,
        stdout: string,
        stderr: string,
    }
    run: func(program: string, args: list<string>, timeout-ms: u32) -> result<output, string>;
}

/// A notice shown to the user, as the app shows its own.
interface notify {
    enum tone { info, success, warning, error }
    show: func(title: string, body: string, tone: tone);
}

interface http {
    record response {
        status: u16,
        body: string,
    }
    fetch: func(method: string, url: string, headers: list<tuple<string, string>>, body: option<string>) -> result<response, string>;
}

world plugin {
    use types.{tool-call, before-tool, tool-result, after-tool, prompt, prompt-submit, reply, turn-end, permission-ask, permission, compaction, compacting, session, session-kind};
    import host;
    import store;
    import files;
    import process;
    import http;
    import notify;

    export name: func() -> string;
    export before-tool: func(call: tool-call) -> before-tool;
    export after-tool: func(outcome: tool-result) -> after-tool;
    export prompt-submit: func(prompt: prompt) -> prompt-submit;
    export turn-end: func(reply: reply) -> turn-end;
    export permission: func(ask: permission-ask) -> permission;
    export compaction: func(compaction: compaction) -> compacting;
    export session: func(session: session, kind: session-kind);
}
