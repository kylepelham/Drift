package drift:plugin@0.2.0;

/// What Drift tells a plugin and what it may answer; JSON travels as strings.
interface types {
    record tool-call {
        session-id: string,
        workspace: string,
        agent: string,
        tool: string,
        /// The tool's input as JSON.
        input: string,
    }

    variant before-tool {
        allow,
        /// The call does not run; the model is told why.
        deny(string),
        /// The call runs with this JSON input instead.
        replace(string),
    }

    record tool-result {
        session-id: string,
        workspace: string,
        agent: string,
        tool: string,
        input: string,
        /// What the model will read, up to the engine's bound.
        output: string,
        /// The tool errored, or a shell command exited non-zero.
        failed: bool,
    }

    variant after-tool {
        keep,
        /// The model reads this instead.
        replace(string),
        /// One line under the output, shown as "<plugin>: <note>"; cut at 160 characters.
        note(string),
    }

    /// The user's prompt, before the model sees it.
    record prompt {
        session-id: string,
        workspace: string,
        agent: string,
        text: string,
    }

    variant prompt-submit {
        keep,
        /// The model reads this text instead of the user's.
        replace(string),
        /// Added beside the prompt as context from the plugin; the user sees it too.
        add-context(string),
        /// The prompt is not sent; the user is told why.
        deny(string),
    }

    /// The model's reply that ended a turn.
    record reply {
        session-id: string,
        workspace: string,
        agent: string,
        text: string,
    }

    variant turn-end {
        accept,
        /// The turn ends; the line is shown under the reply as the plugin's, and the model never sees it.
        note(string),
        /// The turn goes on: the reason is sent to the model as a prompt from the plugin.
        continue(string),
    }

    /// A call the rules would ask the user about.
    record permission-ask {
        session-id: string,
        workspace: string,
        agent: string,
        tool: string,
        /// The rule namespace: `bash`, `edit`, `read`, `webfetch`, `mcp`, ...
        kind: string,
        /// What is touched: a path, a command line, a URL.
        pattern: string,
        title: string,
        /// For a shell line, the simple commands it runs; absent when the line hides what it runs.
        commands: option<list<string>>,
    }

    variant permission {
        /// Not the plugin's call: the user is asked as usual.
        pass,
        allow,
        /// The call does not run; the model is told why.
        deny(string),
    }

    /// A conversation about to be summarised.
    record compaction {
        session-id: string,
        workspace: string,
        agent: string,
    }

    variant compacting {
        proceed,
        /// Added to the summariser's instructions, so the summary keeps what the plugin needs.
        instruct(string),
    }

    enum session-kind {
        created,
        running,
        idle,
        updated,
        deleted,
        /// Its history was summarised.
        compacted,
    }

    record session {
        id: string,
        workspace: string,
        title: string,
        agent: string,
    }

    /// One setting a plugin offers. Settings draws a form from them and keeps the values in the plugin's
    /// drift.json entry, under `key` of its config object; `host.config` gives every unset one its default.
    record setting {
        key: string,
        label: string,
        /// One short line under the label; empty for none.
        description: string,
        kind: setting-kind,
    }

    variant setting-kind {
        /// Kept as a string.
        text(text-setting),
        /// Kept as a number.
        number(number-setting),
        /// Kept as true or false; the payload is the default.
        toggle(bool),
        /// One of the values offered, kept as a string.
        choice(choice-setting),
        /// Any number of lines, each its own row with + to add another; kept as a list of strings.
        items(items-setting),
        /// Any number of pairs, each a row of two fields with + to add another; kept as an object of strings.
        pairs(pairs-setting),
    }

    record text-setting {
        default: string,
        placeholder: string,
        /// A box of several lines instead of one.
        multiline: bool,
        /// Hidden as it is typed, with a button to show it.
        secret: bool,
    }

    record number-setting {
        default: option<f64>,
        min: option<f64>,
        max: option<f64>,
        /// Whole numbers only.
        integer: bool,
    }

    record choice-setting {
        default: string,
        /// Each a value and the label shown for it.
        choices: list<tuple<string, string>>,
    }

    record items-setting {
        default: list<string>,
        placeholder: string,
        secret: bool,
    }

    record pairs-setting {
        default: list<tuple<string, string>>,
        /// What each column holds, as headings and empty-field hints.
        key-label: string,
        value-label: string,
        secret-keys: bool,
        secret-values: bool,
    }

    /// A language server Drift starts over stdio for the errors an edit leaves, as drift.json's `lsp` adds one.
    record language-server {
        /// Its name; a drift.json `lsp` entry of the same name replaces it, or turns it off when `false`.
        id: string,
        /// The program and its arguments, found on PATH as a built-in server's are.
        command: list<string>,
        /// File name endings it handles, such as ".roc".
        extensions: list<string>,
        /// The LSP language id it is told; by the file's extension when none.
        language: option<string>,
    }

    /// A TextMate grammar that highlights code, in files and in Markdown code fences.
    record grammar {
        /// The language's name, which a code fence uses; a bundled language of the same name is replaced.
        name: string,
        /// Other fence names for it.
        aliases: list<string>,
        /// File name endings it highlights, such as ".roc", or whole names, such as "Rocfile".
        extensions: list<string>,
        /// The grammar as `.tmLanguage.json` text, with its `scopeName` and `patterns`.
        json: string,
    }
}

interface host {
    enum level { info, warn, error }
    log: func(level: level, message: string);
    /// The plugin's own object from its drift.json entry, as JSON; "{}" when none.
    config: func() -> string;
}

/// The plugin's own values, kept by Drift across runs.
interface store {
    get: func(key: string) -> option<string>;
    set: func(key: string, value: string);
}

/// Files under the workspace of the event being handled; nothing outside it.
interface files {
    read: func(path: string) -> result<string, string>;
    write: func(path: string, content: string) -> result<_, string>;
}

/// A program run in the event's workspace, with its output bounded.
interface process {
    record output {
        code: s32,
        stdout: string,
        stderr: string,
    }
    run: func(program: string, args: list<string>, timeout-ms: u32) -> result<output, string>;
}

/// A notice shown to the user, as the app shows its own.
interface notify {
    enum tone { info, success, warning, error }
    show: func(title: string, body: string, tone: tone);
}

interface http {
    record response {
        status: u16,
        body: string,
    }
    fetch: func(method: string, url: string, headers: list<tuple<string, string>>, body: option<string>) -> result<response, string>;
}

world plugin {
    use types.{tool-call, before-tool, tool-result, after-tool, prompt, prompt-submit, reply, turn-end, permission-ask, permission, compaction, compacting, session, session-kind};
    import host;
    import store;
    import files;
    import process;
    import http;
    import notify;

    export name: func() -> string;
    export before-tool: func(call: tool-call) -> before-tool;
    export after-tool: func(outcome: tool-result) -> after-tool;
    export prompt-submit: func(prompt: prompt) -> prompt-submit;
    export turn-end: func(reply: reply) -> turn-end;
    export permission: func(ask: permission-ask) -> permission;
    export compaction: func(compaction: compaction) -> compacting;
    export session: func(session: session, kind: session-kind);
}

/// A plugin with settings: Settings shows a form for them instead of its raw JSON config. Asked once
/// when the plugin loads, before anything else it exports; a plugin built for `plugin` alone keeps working.
world configurable {
    include plugin;
    use types.{setting};
    export settings: func() -> list<setting>;
}

/// A plugin that also keeps secrets from the model. Each pair is a secret and the placeholder the model
/// sees instead: in prompts, text files, instructions, tool output and errors, all text sent to a model.
/// Image and PDF data are sent as they are, so a secret inside one still reaches the model.
/// Placeholders the model writes in a tool call become the secrets again before the call runs. Asked
/// once when the plugin loads; a plugin built for `plugin` alone keeps working.
world masking {
    include configurable;
    export replacements: func() -> list<tuple<string, string>>;
}

/// A plugin that also answers web searches for the `websearch` tool. `search-providers` lists the ids and
/// names it answers for, asked once at load; Settings lists them beside the built-in ones. `search` gives
/// each hit as a url, a title and a snippet, or an error with, when rate limited, the seconds to wait.
world searching {
    include configurable;
    export search-providers: func() -> list<tuple<string, string>>;
    export search: func(provider: string, query: string, limit: u32) -> result<list<tuple<string, string, string>>, tuple<string, option<u32>>>;
}

/// A plugin that adds languages: language servers, which Settings lists as its capability since Drift starts
/// them, and grammars that highlight code. Both are asked once when the plugin loads; a plugin built for
/// `plugin` alone keeps working.
world languages {
    include configurable;
    use types.{language-server, grammar};
    export language-servers: func() -> list<language-server>;
    export grammars: func() -> list<grammar>;
}
