+++ b/packages/opencode/src/session/fork-history.ts
@@ -0,0 +1,65 @@
+import { and, asc, desc, eq, gt, lt, lte, or, sql, type SQL } from "drizzle-orm"
+import { Effect } from "effect"
+import { Database } from "@opencode-ai/core/database/database"
+import { MessageTable } from "@opencode-ai/core/session/sql"
+import type { SessionV1 } from "@opencode-ai/core/v1/session"
+import { MessageV2 } from "./message-v2"
+import type { MessageID, SessionID } from "./schema"
+
+// Only message headers for one page are retained. Tool output and attachments are read one
+// message at a time, instead of materializing the entire source transcript before copying.
+export const copyFullFork = Effect.fn("Session.copyFullFork")(function* <R>(
+  input: { sessionID: SessionID; messageID?: MessageID; mode?: "active" | "full" },
+  busy: boolean,
+  copy: (message: SessionV1.WithParts) => Effect.Effect<void, never, R>,
+) {
+  const { db } = yield* Database.Service
+  const source = eq(MessageTable.session_id, input.sessionID)
+  let cutoff = input.messageID
+  if (!cutoff && busy) {
+    const user = yield* db.select({ id: MessageTable.id }).from(MessageTable)
+      .where(and(source, sql`json_extract(${MessageTable.data}, '$.role') = 'user'`))
+      .orderBy(desc(MessageTable.time_created), desc(MessageTable.id)).limit(1).get().pipe(Effect.orDie)
+    cutoff = user?.id
+  }
+  const bounded = cutoff ? and(source, lt(MessageTable.id, cutoff))! : source
+  // Freeze the last eligible message before copying. New turns appended during the copy are
+  // excluded, and an unfinished trailing turn is omitted for Drift's explicit full mode.
+  const terminal = input.mode === "full"
+    ? and(bounded,
+        sql`json_extract(${MessageTable.data}, '$.role') = 'assistant'`,
+        sql`(json_extract(${MessageTable.data}, '$.time.completed') IS NOT NULL
+          OR json_extract(${MessageTable.data}, '$.finish') IS NOT NULL
+          OR json_extract(${MessageTable.data}, '$.error') IS NOT NULL)`)
+    : bounded
+  let last = input.mode === "full"
+    ? yield* db.select({ id: MessageTable.id }).from(MessageTable).where(terminal)
+      .orderBy(desc(MessageTable.time_created), desc(MessageTable.id)).limit(1).get().pipe(Effect.orDie)
+    : undefined
+  // Preserve legacy behavior when no completed assistant exists, including user-only histories.
+  if (!last)
+    last = yield* db.select({ id: MessageTable.id }).from(MessageTable).where(bounded)
+      .orderBy(desc(MessageTable.id)).limit(1).get().pipe(Effect.orDie)
+  if (!last) return
+  const upper = and(bounded, lte(MessageTable.id, last.id))!
+  let after: { id: MessageID; time: number } | undefined
+  while (true) {
+    const conditions: SQL[] = [upper]
+    if (after) conditions.push(or(
+      gt(MessageTable.time_created, after.time),
+      and(eq(MessageTable.time_created, after.time), gt(MessageTable.id, after.id)),
+    )!)
+    const rows = yield* db.select().from(MessageTable).where(and(...conditions))
+      .orderBy(asc(MessageTable.time_created), asc(MessageTable.id)).limit(25).all().pipe(Effect.orDie)
+    if (!rows.length) return
+    for (const row of rows) {
+      yield* copy({
+        info: { ...row.data, id: row.id, sessionID: row.session_id } as SessionV1.Info,
+        parts: yield* MessageV2.parts(row.id),
+      })
+    }
+    const tail = rows[rows.length - 1]!
+    after = { id: tail.id, time: tail.time_created }
+    yield* Effect.yieldNow
+  }
+})
