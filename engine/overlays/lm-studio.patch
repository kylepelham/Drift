+const LM_STUDIO_BASE_URL = "http://127.0.0.1:1234/v1"
+
+function positiveInteger(input: unknown) {
+  if (typeof input !== "number" || !Number.isInteger(input) || input <= 0) return
+  return input
+}
+
+function lmStudioBaseURL(input: unknown) {
+  if (typeof input !== "string" || input.trim() === "") return LM_STUDIO_BASE_URL
+  try {
+    const url = new URL(input)
+    const pathname = url.pathname.replace(/\/+$/, "")
+    url.pathname = pathname.endsWith("/v1") ? pathname : `${pathname}/v1`
+    return url.toString().replace(/\/$/, "")
+  } catch {
+    return LM_STUDIO_BASE_URL
+  }
+}
+
+function lmStudioDiscoveryURL(baseURL: string) {
+  const url = new URL(baseURL)
+  url.pathname = "/api/v1/models"
+  url.search = ""
+  url.hash = ""
+  return url.toString()
+}
+
+function lmStudioModels(input: unknown, provider: Info, baseURL: string) {
+  if (!isRecord(input) || !Array.isArray(input.models)) return
+  const models: Record<string, Model> = {}
+
+  for (const item of input.models) {
+    if (!isRecord(item) || item.type !== "llm" || typeof item.key !== "string") continue
+    const maximumContext = positiveInteger(item.max_context_length)
+    const capabilities = isRecord(item.capabilities) ? item.capabilities : {}
+    const loaded = Array.isArray(item.loaded_instances)
+      ? item.loaded_instances.filter((instance) => isRecord(instance))
+      : []
+    const instances = loaded.length > 0 ? loaded : [{ id: item.key }]
+
+    for (const instance of instances) {
+      const modelID = typeof instance.id === "string" ? instance.id : item.key
+      const config = isRecord(instance.config) ? instance.config : {}
+      const context = positiveInteger(config.context_length) ?? maximumContext
+      if (!context) continue
+      const catalog = provider.models[modelID] ?? provider.models[item.key]
+      const isLoaded = loaded.length > 0
+      const output = Math.max(256, Math.min(catalog?.limit.output ?? 8192, Math.floor(context / 4)))
+      const vision = capabilities.vision === true
+
+      models[modelID] = {
+        id: ModelV2.ID.make(modelID),
+        providerID: ProviderV2.ID.make(provider.id),
+        api: {
+          id: modelID,
+          npm: "@ai-sdk/openai-compatible",
+          url: baseURL,
+        },
+        name: typeof item.display_name === "string" ? item.display_name : (catalog?.name ?? modelID),
+        family: typeof item.architecture === "string" ? item.architecture : (catalog?.family ?? ""),
+        capabilities: {
+          temperature: true,
+          reasoning: capabilities.reasoning === true,
+          attachment: vision,
+          toolcall: isLoaded && capabilities.trained_for_tool_use === true,
+          input: { text: true, audio: false, image: vision, video: false, pdf: false },
+          output: { text: true, audio: false, image: false, video: false, pdf: false },
+          interleaved: false,
+        },
+        cost: { input: 0, output: 0, cache: { read: 0, write: 0 } },
+        limit: { context, output },
+        status: "active",
+        options: {},
+        headers: {},
+        release_date: catalog?.release_date ?? "",
+        variants: {},
+      }
+    }
+  }
+
+  return models
+}
