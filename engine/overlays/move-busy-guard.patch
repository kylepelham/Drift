+import { NodeHttpServer } from "@effect/platform-node"
+import { describe, expect } from "bun:test"
+import { Context, Effect, Layer, Option, Ref } from "effect"
+import { HttpBody, HttpClient, HttpClientRequest, HttpRouter } from "effect/unstable/http"
+import { HttpApiBuilder } from "effect/unstable/httpapi"
+import { MoveSession } from "@opencode-ai/core/control-plane/move-session"
+import { AbsolutePath } from "@opencode-ai/core/schema"
+import { SessionV2 } from "@opencode-ai/core/session"
+import { Auth } from "../../src/auth"
+import { Config } from "../../src/config/config"
+import { Installation } from "../../src/installation"
+import { Project } from "../../src/project/project"
+import { ServerAuth } from "../../src/server/auth"
+import { RootHttpApi } from "../../src/server/routes/instance/httpapi/api"
+import { controlHandlers } from "../../src/server/routes/instance/httpapi/handlers/control"
+import { controlPlaneHandlers } from "../../src/server/routes/instance/httpapi/handlers/control-plane"
+import { globalHandlers } from "../../src/server/routes/instance/httpapi/handlers/global"
+import { authorizationLayer } from "../../src/server/routes/instance/httpapi/middleware/authorization"
+import { schemaErrorLayer } from "../../src/server/routes/instance/httpapi/middleware/schema-error"
+import { Session } from "../../src/session/session"
+import { SessionStatus } from "../../src/session/status"
+import { NotFoundError } from "../../src/storage/storage"
+import { testEffect } from "../lib/effect"
+
+const input = MoveSession.Input.make({
+  sessionID: SessionV2.ID.make("ses_move"),
+  destination: { directory: AbsolutePath.make("/destination") },
+  moveChanges: true,
+})
+const busyInput = MoveSession.Input.make({
+  sessionID: SessionV2.ID.make("ses_busy"),
+  destination: { directory: AbsolutePath.make("/destination") },
+  moveChanges: false,
+})
+const idleInput = MoveSession.Input.make({
+  sessionID: SessionV2.ID.make("ses_idle"),
+  destination: { directory: AbsolutePath.make("/destination") },
+  moveChanges: false,
+})
+const called = Ref.makeUnsafe<MoveSession.Input | undefined>(undefined)
+
+function info(id: string, directory: string) {
+  return { id, directory } as unknown as Session.Info
+}
+
+const sessionInfos = new Map<string, Session.Info>([
+  ["ses_move", info("ses_move", "/destination")],
+  ["ses_busy", info("ses_busy", "/source")],
+  ["ses_busy_child", info("ses_busy_child", "/source")],
+  ["ses_idle", info("ses_idle", "/source")],
+])
+
+const apiLayer = HttpRouter.serve(
+  HttpApiBuilder.layer(RootHttpApi).pipe(
+    Layer.provide([controlHandlers, controlPlaneHandlers, globalHandlers]),
+    Layer.provide([authorizationLayer, schemaErrorLayer]),
+    // Raw HttpApi routes expose an opaque handler context at the request boundary.
+    // oxlint-disable-next-line typescript-eslint/no-unsafe-type-assertion
+    HttpRouter.provideRequest(Layer.succeedContext(Context.empty() as Context.Context<unknown>)),
+  ),
+  { disableListenLog: true, disableLogger: true },
+).pipe(
+  Layer.provideMerge(NodeHttpServer.layerTest),
+  Layer.provide(Layer.mock(Auth.Service)({})),
+  Layer.provide(Layer.mock(Config.Service)({})),
+  Layer.provide(Layer.mock(Installation.Service)({})),
+  Layer.provide(
+    Layer.mock(MoveSession.Service)({
+      moveSession: (value) => Ref.set(called, value),
+    }),
+  ),
+  Layer.provide(
+    Layer.mock(Session.Service)({
+      get: (id) => {
+        const found = sessionInfos.get(id)
+        return found
+          ? Effect.succeed(found)
+          : Effect.fail(new NotFoundError({ message: `Session not found: ${id}` }))
+      },
+      children: (parentID) =>
+        Effect.succeed(parentID === "ses_busy" ? [sessionInfos.get("ses_busy_child")!] : []),
+    }),
+  ),
+  Layer.provide(
+    Layer.mock(SessionStatus.Service)({
+      get: (id) => Effect.succeed(id === "ses_busy_child" ? { type: "busy" as const } : { type: "idle" as const }),
+    }),
+  ),
+  Layer.provide(
+    Layer.mock(Project.Service)({
+      fromDirectory: (directory) =>
+        Effect.succeed({ project: { id: "prj_test" } as unknown as Project.Info, sandbox: directory }),
+    }),
+  ),
+  Layer.provide(ServerAuth.Config.configLayer({ password: Option.none(), username: "opencode" })),
+)
+const it = testEffect(apiLayer)
+
+describe("control-plane HttpApi", () => {
+  it.live("moves a session through the root control-plane route", () =>
+    Effect.gen(function* () {
+      const response = yield* HttpClientRequest.post("/experimental/control-plane/move-session").pipe(
+        HttpClientRequest.setBody(HttpBody.jsonUnsafe(input)),
+        HttpClient.execute,
+      )
+
+      expect(response.status).toBe(204)
+      expect(yield* Ref.get(called)).toEqual(input)
+    }),
+  )
+
+  it.live("rejects a move while any session in the tree is busy", () =>
+    Effect.gen(function* () {
+      yield* Ref.set(called, undefined)
+      const response = yield* HttpClientRequest.post("/experimental/control-plane/move-session").pipe(
+        HttpClientRequest.setBody(HttpBody.jsonUnsafe(busyInput)),
+        HttpClient.execute,
+      )
+
+      expect(response.status).toBe(400)
+      const body = (yield* response.json) as { data: { message: string } }
+      expect(body.data.message).toContain("busy")
+      expect(yield* Ref.get(called)).toBeUndefined()
+    }),
+  )
+
+  it.live("moves a session whose tree is confirmed idle", () =>
+    Effect.gen(function* () {
+      yield* Ref.set(called, undefined)
+      const response = yield* HttpClientRequest.post("/experimental/control-plane/move-session").pipe(
+        HttpClientRequest.setBody(HttpBody.jsonUnsafe(idleInput)),
+        HttpClient.execute,
+      )
+
+      expect(response.status).toBe(204)
+      expect(yield* Ref.get(called)).toEqual(idleInput)
+    }),
+  )
+})
