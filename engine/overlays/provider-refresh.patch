+          hostname: "127.0.0.1",
+          port: 0,
+          fetch(request) {
+            if (new URL(request.url).pathname !== "/api/v1/models") return new Response(null, { status: 404 })
+            return Response.json({
+              models: [{
+                type: "llm",
+                key: model,
+                display_name: model,
+                architecture: "qwen35",
+                max_context_length: 65536,
+                capabilities: { trained_for_tool_use: true },
+                loaded_instances: [],
+              }],
+            })
+          },
+        }),
+      ),
+      (server) => Effect.promise(() => server.stop(true)),
+    )
+    yield* remove("LMSTUDIO_API_KEY")
+    yield* set("LMSTUDIO_BASE_URL", `http://127.0.0.1:${server.port}`)
+
+    const providerID = ProviderV2.ID.make("lmstudio")
+    expect(Object.keys((yield* list)[providerID].models)).toEqual(["local/first"])
+    model = "local/second"
+    expect(Object.keys((yield* list)[providerID].models)).toEqual(["local/first"])
+    yield* reload
+    expect(Object.keys((yield* list)[providerID].models)).toEqual(["local/second"])
+  }),
+)
