--- /dev/null
+++ b/packages/opencode/src/tool/shell-timeout.ts
@@ -0,0 +1,19 @@
+let timeoutMs: number | undefined
+
+export function configure(value: number | null) {
+  timeoutMs = value ?? undefined
+}
+
+export function snapshot(explicit?: number, fallback?: number) {
+  return explicit ?? timeoutMs ?? fallback
+}
+
+export function current() {
+  return timeoutMs
+}
+
+export const ShellTimeout = {
+  configure,
+  current,
+  snapshot,
+}
