diff --git a/packages/opencode/test/tool/shell-timeout.test.ts b/packages/opencode/test/tool/shell-timeout.test.ts
new file mode 100644
index 0000000..ff37fab
--- /dev/null
+++ b/packages/opencode/test/tool/shell-timeout.test.ts
@@ -0,0 +1,30 @@
+import { afterEach, expect, test } from "bun:test"
+import { ShellTimeout } from "../../src/tool/shell-timeout"
+
+afterEach(() => ShellTimeout.configure(null))
+
+test("preserves no-timeout behavior by default", () => {
+  ShellTimeout.configure(null)
+  expect(ShellTimeout.snapshot()).toBeUndefined()
+})
+
+test("snapshots changed defaults for newly started shell calls", () => {
+  ShellTimeout.configure(300_000)
+  const running = ShellTimeout.snapshot()
+  ShellTimeout.configure(60_000)
+  const next = ShellTimeout.snapshot()
+  expect(running).toBe(300_000)
+  expect(next).toBe(60_000)
+})
+
+test("does not apply the shell timeout class to other tools", async () => {
+  const files = ["../../src/tool/webfetch.ts", "../../src/mcp/index.ts"]
+  for (const file of files) {
+    expect(await Bun.file(new URL(file, import.meta.url)).text()).not.toContain("ShellTimeout")
+  }
+  const shell = await Bun.file(new URL("../../src/tool/shell.ts", import.meta.url)).text()
+  expect(shell).toContain("timedOut: expired")
+  expect(shell).toContain("shellTimeoutMs: input.timeout ?? null")
+  const spawner = await Bun.file(new URL("../../../core/src/cross-spawn-spawner.ts", import.meta.url)).text()
+  expect(spawner).toContain("taskkill /pid ${proc.pid} /T /F")
+})
