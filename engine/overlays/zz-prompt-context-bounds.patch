index 000000000..e8ee5f9cb
--- /dev/null
+++ b/packages/opencode/test/session/compaction-scan.test.ts
@@ -0,0 +1,60 @@
+import { expect, test } from "bun:test"
+import { compactionScanner, filterCompacted } from "../../src/session/message-v2"
+
+type Loose = Parameters<ReturnType<typeof compactionScanner>["push"]>[0]
+
+function user(id: string, parts: object[] = []): Loose {
+  return { info: { id, role: "user", time: { created: 1 } }, parts } as Loose
+}
+
+function assistant(id: string, parentID: string, options: { summary?: boolean } = {}): Loose {
+  return {
+    info: {
+      id,
+      role: "assistant",
+      parentID,
+      time: { created: 1 },
+      summary: options.summary ?? false,
+      finish: options.summary ? "stop" : undefined,
+    },
+    parts: [],
+  } as unknown as Loose
+}
+
+const compaction = (tail: string) => ({ type: "compaction", tail_start_id: tail })
+
+// Chronological: u1 a1 u2(compaction tail=u1) a2(summary of u2) u3 a3
+const tail = [assistant("a3", "u3"), user("u3"), assistant("a2", "u2", { summary: true })]
+const boundary = [user("u2", [compaction("u1")]), assistant("a1", "u1"), user("u1")]
+const ancient = [assistant("a0", "u0"), user("u0")]
+
+test("filterCompacted reorders the compacted session for model consumption", () => {
+  const result = filterCompacted([...tail, ...boundary, ...ancient])
+  expect(result.map((m) => m.info.id as string)).toEqual(["u2", "a2", "u1", "a1", "u3", "a3"])
+})
+
+test("the scanner reports the boundary so paged callers stop loading history", () => {
+  const scanner = compactionScanner()
+  const consumed: string[] = []
+  for (const msg of [...tail, ...boundary, ...ancient]) {
+    consumed.push(msg.info.id as string)
+    if (scanner.push(msg)) break
+  }
+  // Stops at u1 (the compaction tail start); the ancient messages are never consumed.
+  expect(consumed).toEqual(["a3", "u3", "a2", "u2", "a1", "u1"])
+  expect(scanner.push(ancient[0]!)).toBeTrue()
+  expect(scanner.finish().map((m) => m.info.id as string)).toEqual(["u2", "a2", "u1", "a1", "u3", "a3"])
+})
+
+test("sessions without compaction keep their full chronological history", () => {
+  const msgs = [assistant("a1", "u1"), user("u1")]
+  expect(filterCompacted(msgs).map((m) => m.info.id as string)).toEqual(["u1", "a1"])
+})
+
+test("the effect pages instead of streaming the whole session", async () => {
+  const source = await Bun.file(new URL("../../src/session/message-v2.ts", import.meta.url)).text()
+  const effect = source.slice(source.indexOf("export const filterCompactedEffect"))
+  expect(effect).toContain("compactionScanner()")
+  expect(effect).toContain("page({ sessionID, limit: size, before })")
+  expect(effect).not.toContain("yield* stream(")
+})
