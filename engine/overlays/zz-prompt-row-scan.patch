diff --git a/packages/opencode/test/session/compaction-row-scan.test.ts b/packages/opencode/test/session/compaction-row-scan.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/opencode/test/session/compaction-row-scan.test.ts
@@ -0,0 +1,154 @@
+import { describe, expect } from "bun:test"
+import { Database } from "@opencode-ai/core/database/database"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { ModelV2 } from "@opencode-ai/core/model"
+import { ProviderV2 } from "@opencode-ai/core/provider"
+import { SessionProjector } from "@opencode-ai/core/session/projector"
+import { SessionV1 } from "@opencode-ai/core/v1/session"
+import { sql } from "drizzle-orm"
+import { Effect } from "effect"
+import { Session as SessionNs } from "@/session/session"
+import { MessageV2 } from "../../src/session/message-v2"
+import { SessionSummary } from "../../src/session/summary"
+import { MessageID, PartID, type SessionID } from "../../src/session/schema"
+import { testEffect } from "../lib/effect"
+
+const it = testEffect(
+  LayerNode.compile(LayerNode.group([SessionNs.node, MessageV2.node, SessionProjector.node, SessionSummary.node])),
+)
+
+const withSession = <A, E, R>(
+  fn: (input: { session: SessionNs.Interface; sessionID: SessionID }) => Effect.Effect<A, E, R>,
+) =>
+  Effect.acquireUseRelease(
+    Effect.gen(function* () {
+      const session = yield* SessionNs.Service
+      const created = yield* session.create({})
+      return { session, sessionID: created.id }
+    }),
+    fn,
+    (input) => input.session.remove(input.sessionID).pipe(Effect.ignore),
+  )
+
+const addUser = Effect.fn("Test.addUser")(function* (sessionID: SessionID, text?: string) {
+  const session = yield* SessionNs.Service
+  const id = MessageID.ascending()
+  yield* session.updateMessage({
+    id,
+    sessionID,
+    role: "user",
+    time: { created: Date.now() },
+    agent: "test",
+    model: { providerID: "test", modelID: "test" },
+    tools: {},
+    mode: "",
+  } as unknown as SessionV1.Info)
+  if (text) {
+    yield* session.updatePart({
+      id: PartID.ascending(),
+      sessionID,
+      messageID: id,
+      type: "text",
+      text,
+    })
+  }
+  return id
+})
+
+const addAssistant = Effect.fn("Test.addAssistant")(function* (
+  sessionID: SessionID,
+  parentID: MessageID,
+  summary = false,
+) {
+  const session = yield* SessionNs.Service
+  const id = MessageID.ascending()
+  yield* session.updateMessage({
+    id,
+    sessionID,
+    role: "assistant",
+    time: { created: Date.now() },
+    parentID,
+    modelID: ModelV2.ID.make("test"),
+    providerID: ProviderV2.ID.make("test"),
+    mode: "",
+    agent: "default",
+    path: { cwd: "/", root: "/" },
+    cost: 0,
+    tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+    summary,
+    finish: "end_turn",
+  } as unknown as SessionV1.Info)
+  return id
+})
+
+const addCompaction = Effect.fn("Test.addCompaction")(function* (sessionID: SessionID, messageID: MessageID) {
+  const session = yield* SessionNs.Service
+  yield* session.updatePart({
+    id: PartID.ascending(),
+    sessionID,
+    messageID,
+    type: "compaction",
+    auto: true,
+  } as SessionV1.CompactionPart)
+})
+
+const fill = Effect.fn("Test.fill")(function* (sessionID: SessionID, count: number) {
+  const ids = [] as MessageID[]
+  for (let index = 0; index < count; index++) ids.push(yield* addUser(sessionID, `message ${index}`))
+  return ids
+})
+
+describe("MessageV2.filterCompactedEffect row scan", () => {
+  it.instance("retains history for an incomplete compaction", () =>
+    withSession(({ sessionID }) =>
+      Effect.gen(function* () {
+        const before = yield* fill(sessionID, 2)
+        const compaction = yield* addUser(sessionID)
+        yield* addCompaction(sessionID, compaction)
+        const incomplete = yield* addAssistant(sessionID, compaction)
+        const after = yield* fill(sessionID, 60)
+
+        const result = yield* MessageV2.filterCompactedEffect(sessionID)
+        expect(result.map((item) => item.info.id)).toEqual([...before, compaction, incomplete, ...after])
+      }),
+    ),
+  )
+
+  it.instance("does not hydrate parts before a completed full compaction", () =>
+    withSession(({ sessionID }) =>
+      Effect.gen(function* () {
+        const old = yield* addUser(sessionID, "old prompt")
+        const compaction = yield* addUser(sessionID)
+        yield* addCompaction(sessionID, compaction)
+        const summary = yield* addAssistant(sessionID, compaction, true)
+        const recent = yield* fill(sessionID, 60)
+
+        const { db } = yield* Database.Service
+        yield* db.run(sql`UPDATE part SET data = 'invalid json' WHERE message_id = ${old}`)
+
+        const result = yield* MessageV2.filterCompactedEffect(sessionID)
+        expect(result.map((item) => item.info.id)).toEqual([compaction, summary, ...recent])
+      }),
+    ),
+  )
+
+  it.instance("summary loading stops at the current turn", () =>
+    withSession(({ sessionID }) =>
+      Effect.gen(function* () {
+        const old = (yield* fill(sessionID, 60))[0]!
+        const target = yield* addUser(sessionID, "current prompt")
+        yield* addAssistant(sessionID, target)
+
+        const { db } = yield* Database.Service
+        yield* db.run(sql`UPDATE part SET data = 'invalid json' WHERE message_id = ${old}`)
+
+        const summary = yield* SessionSummary.Service
+        yield* summary.summarize({ sessionID, messageID: target })
+
+        const message = yield* MessageV2.get({ sessionID, messageID: target })
+        if (message.info.role !== "user" || !message.info.summary) throw new Error("Expected summarized user message")
+        expect(message.info.summary.diffs).toEqual([])
+      }),
+    ),
+  )
+})
