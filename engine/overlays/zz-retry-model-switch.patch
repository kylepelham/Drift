--- /dev/null
+++ b/packages/opencode/test/session/retry-model-switch.test.ts
@@ -0,0 +1,87 @@
+import { expect, test } from "bun:test"
+import { Effect } from "effect"
+import type { ModelV2 } from "@opencode-ai/core/model"
+import type { ProviderV2 } from "@opencode-ai/core/provider"
+import { RetryModelSwitch } from "../../src/session/retry-switch"
+import type { SessionID } from "../../src/session/schema"
+
+const selection = {
+  providerID: "anthropic" as ProviderV2.ID,
+  modelID: "claude-test" as ModelV2.ID,
+  variant: "high",
+}
+
+test("only the exact parked attempt accepts a switch", async () => {
+  const sessionID = "ses_switch_exact" as SessionID
+  await Effect.runPromise(
+    Effect.gen(function* () {
+      const window = yield* RetryModelSwitch.open(sessionID, "msg_1")
+      // Streaming attempts are never switchable: interrupting a live stream loses output.
+      expect(yield* RetryModelSwitch.request({ sessionID, messageID: "msg_1", selection })).toBeFalse()
+
+      RetryModelSwitch.park(sessionID, "msg_1")
+      expect(yield* RetryModelSwitch.request({ sessionID, messageID: "msg_2", selection })).toBeFalse()
+
+      // The next attempt starting to stream unparks the window.
+      RetryModelSwitch.resume(sessionID, "msg_1")
+      expect(yield* RetryModelSwitch.request({ sessionID, messageID: "msg_1", selection })).toBeFalse()
+
+      RetryModelSwitch.park(sessionID, "msg_1")
+      expect(RetryModelSwitch.isSwitching(sessionID, "msg_1")).toBeFalse()
+      expect(yield* RetryModelSwitch.request({ sessionID, messageID: "msg_1", selection })).toBeTrue()
+      expect(RetryModelSwitch.isSwitching(sessionID, "msg_1")).toBeTrue()
+      expect(yield* window.wait).toEqual(selection)
+
+      // While switching, park/resume are ignored and no second switch can race the first.
+      RetryModelSwitch.resume(sessionID, "msg_1")
+      expect(RetryModelSwitch.isSwitching(sessionID, "msg_1")).toBeTrue()
+      expect(yield* RetryModelSwitch.request({ sessionID, messageID: "msg_1", selection })).toBeFalse()
+      yield* window.close
+    }),
+  )
+})
+
+test("a closed window never accepts a stale selection", async () => {
+  const sessionID = "ses_switch_stale" as SessionID
+  await Effect.runPromise(
+    Effect.gen(function* () {
+      const first = yield* RetryModelSwitch.open(sessionID, "msg_1")
+      RetryModelSwitch.park(sessionID, "msg_1")
+      yield* first.close
+      expect(yield* RetryModelSwitch.request({ sessionID, messageID: "msg_1", selection })).toBeFalse()
+
+      // A newer attempt owns the session's window; requests for the old attempt stay refused.
+      const second = yield* RetryModelSwitch.open(sessionID, "msg_2")
+      RetryModelSwitch.park(sessionID, "msg_2")
+      expect(yield* RetryModelSwitch.request({ sessionID, messageID: "msg_1", selection })).toBeFalse()
+      expect(yield* RetryModelSwitch.request({ sessionID, messageID: "msg_2", selection })).toBeTrue()
+      yield* second.close
+      expect(RetryModelSwitch.isSwitching(sessionID, "msg_2")).toBeFalse()
+    }),
+  )
+})
