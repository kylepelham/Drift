+test("the processor parks retry backoff and skips abort finalization while switching", async () => {
+  const processor = await Bun.file(new URL("../../src/session/processor.ts", import.meta.url)).text()
+  expect(processor).toContain("RetryModelSwitch.park(ctx.sessionID, ctx.assistantMessage.id)")
+  expect(processor).toContain("RetryModelSwitch.resume(ctx.sessionID, ctx.assistantMessage.id)")
+  // The switch interrupt must not finalize the message as aborted or run the abort cleanup.
+  expect(processor).toContain(
+    "if (RetryModelSwitch.isSwitching(ctx.sessionID, ctx.assistantMessage.id)) return",
+  )
+  expect(processor).toContain(
+    "RetryModelSwitch.isSwitching(ctx.sessionID, ctx.assistantMessage.id) ? Effect.void : cleanup()",
+  )
+  // Errors and retry policy attribute to the model of the current attempt, not the original one.
+  expect(processor).toContain("providerID: ctx.model.providerID")
+  expect(processor).toContain("provider: ctx.model.providerID")
+})
