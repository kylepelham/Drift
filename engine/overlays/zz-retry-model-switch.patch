diff --git a/packages/opencode/src/session/retry-switch.ts b/packages/opencode/src/session/retry-switch.ts
new file mode 100644
--- /dev/null
+++ b/packages/opencode/src/session/retry-switch.ts
@@ -0,0 +1,82 @@
+import type { ModelV2 } from "@opencode-ai/core/model"
+import type { ProviderV2 } from "@opencode-ai/core/provider"
+import { Deferred, Effect } from "effect"
+import type { SessionID } from "./schema"
+
+export interface Selection {
+  providerID: ProviderV2.ID
+  modelID: ModelV2.ID
+  variant?: string | undefined
+}
+
+interface Entry {
+  messageID: string
+  selection: Deferred.Deferred<Selection>
+  parked: boolean
+  switching: boolean
+}
+
+// Process-local: a retrying attempt streams in this process, so its switch window lives and
+// dies with the attempt. One entry per session - a session runs at most one attempt at a time.
+const entries = new Map<SessionID, Entry>()
+
+/**
+ * Opens the switch window for one assistant attempt. The caller races `wait` against the
+ * streaming attempt and must run `close` afterwards so a finished attempt can never accept a
+ * selection meant for a newer one.
+ */
+export const open = Effect.fn("RetryModelSwitch.open")(function* (sessionID: SessionID, messageID: string) {
+  const entry: Entry = {
+    messageID,
+    selection: yield* Deferred.make<Selection>(),
+    parked: false,
+    switching: false,
+  }
+  entries.set(sessionID, entry)
+  return {
+    wait: Deferred.await(entry.selection),
+    close: Effect.sync(() => {
+      if (entries.get(sessionID) === entry) entries.delete(sessionID)
+    }),
+  }
+})
+
+/**
+ * Marks the attempt as parked in retry backoff. Only parked attempts accept a switch: while the
+ * provider stream is live, interrupting it mid-output would lose already-streamed content.
+ */
+export function park(sessionID: SessionID, messageID: string) {
+  const entry = entries.get(sessionID)
+  if (entry && entry.messageID === messageID && !entry.switching) entry.parked = true
+}
+
+/** Leaves backoff parking when the next attempt starts streaming. */
+export function resume(sessionID: SessionID, messageID: string) {
+  const entry = entries.get(sessionID)
+  if (entry && entry.messageID === messageID && !entry.switching) entry.parked = false
+}
+
+/**
+ * Accepts a switch for the exact parked attempt, or reports false so the caller can tell the
+ * user the attempt is no longer switchable. Marking `switching` before resolving keeps the
+ * interrupt that follows distinguishable from a user abort.
+ */
+export const request = Effect.fn("RetryModelSwitch.request")(function* (input: {
+  sessionID: SessionID
+  messageID: string
+  selection: Selection
+}) {
+  const entry = entries.get(input.sessionID)
+  if (!entry || entry.messageID !== input.messageID || entry.switching || !entry.parked) return false
+  entry.switching = true
+  yield* Deferred.succeed(entry.selection, input.selection)
+  return true
+})
+
+/** Whether the attempt's interruption was caused by an accepted switch rather than an abort. */
+export function isSwitching(sessionID: SessionID, messageID: string) {
+  const entry = entries.get(sessionID)
+  return entry?.messageID === messageID && entry.switching
+}
+
+export * as RetryModelSwitch from "./retry-switch"
