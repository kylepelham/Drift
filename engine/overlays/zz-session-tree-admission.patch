+test("tree admission blocks activity throughout the busy-check and move window", async () => {
+  await Effect.runPromise(
+    Effect.scoped(
+      Effect.gen(function* () {
+        const gate = SessionRunState.makeAdmissionGate()
+        const checking = yield* Deferred.make<void>()
+        const releaseCheck = yield* Deferred.make<void>()
+        const moving = yield* Deferred.make<void>()
+        const releaseMove = yield* Deferred.make<void>()
+        const activityEntered = yield* Deferred.make<void>()
+
+        const move = yield* gate
+          .whileIdle(
+            input.sessionID,
+            Deferred.succeed(checking, undefined).pipe(
+              Effect.andThen(Deferred.await(releaseCheck)),
+              Effect.andThen(Deferred.succeed(moving, undefined)),
+              Effect.andThen(Deferred.await(releaseMove)),
+            ),
+          )
+          .pipe(Effect.forkChild)
+        yield* Deferred.await(checking)
+
+        const activity = yield* gate
+          .run(input.sessionID, Deferred.succeed(activityEntered, undefined))
+          .pipe(Effect.forkChild)
+        yield* Effect.yieldNow
+        expect(yield* Deferred.isDone(activityEntered)).toBeFalse()
+
+        yield* Deferred.succeed(releaseCheck, undefined)
+        yield* Deferred.await(moving)
+        expect(yield* Deferred.isDone(activityEntered)).toBeFalse()
+
+        yield* Deferred.succeed(releaseMove, undefined)
+        yield* Fiber.join(move)
+        yield* Fiber.join(activity)
+        expect(yield* Deferred.isDone(activityEntered)).toBeTrue()
+      }),
+    ),
+  )
+})
