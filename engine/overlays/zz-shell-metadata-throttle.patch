diff --git a/packages/opencode/test/tool/shell-output-throttle.test.ts b/packages/opencode/test/tool/shell-output-throttle.test.ts
new file mode 100644
index 000000000..4dd8e711e
--- /dev/null
+++ b/packages/opencode/test/tool/shell-output-throttle.test.ts
@@ -0,0 +1,22 @@
+import { expect, test } from "bun:test"
+
+const shell = await Bun.file(new URL("../../src/tool/shell.ts", import.meta.url)).text()
+
+test("streaming shell metadata is throttled instead of published per chunk", () => {
+  expect(shell).toContain("const STREAM_METADATA_INTERVAL_MS = 250")
+  expect(shell).toContain("if (now - metadataAt < STREAM_METADATA_INTERVAL_MS) return Effect.void")
+  // The chunk callback must route every streaming update through the throttle.
+  expect(shell).toContain("return streamMetadata")
+  expect(shell).toContain("Effect.andThen(streamMetadata)")
+  // No unthrottled streaming publish remains inside the chunk callback: the only direct
+  // ctx.metadata calls left are the initial, timeout, and permission-time updates.
+  const streaming = shell.slice(shell.indexOf("Stream.runForEach"), shell.indexOf("const abort"))
+  expect(streaming).not.toContain("ctx.metadata")
+})
+
+test("the throttle cannot suppress terminal output states", () => {
+  // Timeout publishes unconditionally so the UI always shows the final tail and timedOut flag.
+  expect(shell).toContain("timedOut: true")
+  // The tool result carries the full retained tail regardless of throttle timing.
+  expect(shell).toContain("output: last || preview(output)")
+})
