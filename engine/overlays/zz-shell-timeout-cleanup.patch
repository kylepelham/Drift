diff --git a/packages/opencode/test/tool/shell-output-throttle.test.ts b/packages/opencode/test/tool/shell-output-throttle.test.ts
--- a/packages/opencode/test/tool/shell-output-throttle.test.ts
+++ b/packages/opencode/test/tool/shell-output-throttle.test.ts
@@ -20,3 +20,22 @@ test("the throttle cannot suppress terminal output states", () => {
   // The tool result carries the full retained tail regardless of throttle timing.
   expect(shell).toContain("output: last || preview(output)")
 })
+
+test("timeout cleanup cannot wait forever for a child process exit", () => {
+  const cleanup = shell.slice(shell.indexOf('if (exit.kind === "abort")'), shell.indexOf("return exit.kind"))
+  expect(cleanup).toContain("yield* handle.unref.pipe(Effect.ignore)")
+  expect(cleanup).toContain("Effect.forkDetach")
+  expect(cleanup).toContain("Fiber.await(killing)")
+  expect(cleanup).toContain('duration: "5 seconds"')
+  expect(cleanup.match(/handle\.kill/g)).toHaveLength(1)
+  expect(cleanup.indexOf("handle.unref")).toBeLessThan(cleanup.indexOf("handle.kill"))
+  expect(shell).toContain("shell tool requested termination")
+  expect(shell).not.toContain("process tree were terminated")
+})
+
+test("timeout races an interruptible observer instead of the process effect", () => {
+  const race = shell.slice(shell.indexOf("const exit ="), shell.indexOf('if (exit.kind === "abort")'))
+  expect(race).toContain("Fiber.join(exited)")
+  expect(race).not.toContain("handle.exitCode")
+  expect(shell).toContain("Fiber.interruptAll([exited, output])")
+})
