diff --git a/packages/opencode/test/command/arguments.test.ts b/packages/opencode/test/command/arguments.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/opencode/test/command/arguments.test.ts
@@ -0,0 +1,41 @@
+import { expect, test } from "bun:test"
+import { skillArguments } from "../../src/command/arguments"
+
+test("discovers skill subcommands with help from hints, command tables, and explicit invocations", () => {
+  const content = [
+    "| Command | Category | Description | Reference |",
+    "|---|---|---|---|",
+    "| `audit [target]` | Evaluate | Technical quality checks | [guide](audit.md) |",
+    "| `polish [target]` | Refine | Final quality pass | [guide](polish.md) |",
+    ...Array.from({ length: 12 }, (_, i) => `| action-${i} [target] | Refine | Action ${i} | ref |`),
+    "",
+    "**Doctor:** `/design doctor` reports outdated project artifacts.",
+    "**Hooks:** `/design hooks <on|off|status>` manages the detector.",
+  ].join("\n")
+  const result = skillArguments("design", content, "[audit|polish] [target]")
+  expect(result.usage).toBe("[audit|polish] [target]")
+  expect(result.subcommands).toHaveLength(16)
+  expect(result.subcommands[0]).toEqual({ name: "audit", description: "Technical quality checks", usage: "[target]" })
+  expect(result.subcommands.at(-1)).toEqual({ name: "hooks", description: "manages the detector.", usage: "<on|off|status>" })
+})
+
+test("free-form arguments and unrelated or fenced examples do not invent subcommands", () => {
+  const content = [
+    "```md", "| Command | Description |", "|---|---|", "| fake | Example |", "```",
+    "~~~", "`/design hidden` fake", "~~~", "`/other foreign` example",
+    "| Tool | Description |", "|---|---|", "| ignored | Description |",
+  ].join("\n")
+  expect(skillArguments("design", content, "[target]")).toEqual({ usage: "[target]", subcommands: [] })
+})
+
+test("argument-hint alternatives support grouped skill commands without treating targets as choices", () => {
+  expect(skillArguments("design", "", "[shape · audit|critique · polish] [target]").subcommands.map((item) => item.name))
+    .toEqual(["shape", "audit", "critique", "polish"])
+})
+
+test("table command arguments can contain pipes and markdown descriptions stay plain text", () => {
+  const content = "| Command | Description |\n|---|---|\n| `hooks <on|off>` | **Toggle** the [hook](hook.md) |"
+  expect(skillArguments("design", content).subcommands).toEqual([
+    { name: "hooks", usage: "<on|off>", description: "Toggle the hook" },
+  ])
+})
