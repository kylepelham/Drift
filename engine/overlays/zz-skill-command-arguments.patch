--- /dev/null
+++ b/packages/opencode/src/command/arguments.ts
@@ -0,0 +1,68 @@
+export type Subcommand = { name: string; description: string; usage?: string }
+
+function plain(value: string) {
+  return value.replace(/\[([^\]]+)\]\([^)]*\)/g, "$1").replace(/[`*]/g, "").trim()
+}
+
+function cells(line: string) {
+  return line.replace(/`[^`]*`/g, (code) => code.replaceAll("|", "\u0000"))
+    .replace(/\\\|/g, "\u0000").trim().replace(/^\||\|$/g, "").split("|")
+    .map((cell) => plain(cell.replaceAll("\u0000", "|")))
+}
+
+// Discover documented arguments without executing a skill or interpreting its instructions.
+// Only explicit alternatives, command tables, and literal /skill invocations become choices.
+export function skillArguments(name: string, content: string, hint?: string) {
+  const subcommands = new Map<string, Subcommand>()
+  const add = (spec: string, description = "") => {
+    const match = plain(spec).match(/^([a-z][\w-]*)(?:\s+(.+))?$/i)
+    if (!match) return
+    const key = match[1].toLowerCase()
+    const old = subcommands.get(key)
+    subcommands.set(key, {
+      name: match[1], description: description || old?.description || "",
+      ...((match[2] || old?.usage) ? { usage: match[2] || old?.usage } : {}),
+    })
+  }
+  const choices = hint?.match(/^[\[<]([^\]>]+)[\]>]/)?.[1]
+  if (choices && /[|·,]/.test(choices)) {
+    for (const choice of choices.split(/[|·,]/)) add(choice.trim())
+  }
+  let fence: { marker: string; length: number } | undefined
+  let columns: { command: number; description: number } | undefined
+  for (const line of content.split(/\r?\n/)) {
+    const marker = line.match(/^\s{0,3}(`{3,}|~{3,})/)
+    if (marker) {
+      if (!fence) fence = { marker: marker[1][0], length: marker[1].length }
+      else if (marker[1][0] === fence.marker && marker[1].length >= fence.length) fence = undefined
+      columns = undefined
+      continue
+    }
+    if (fence) continue
+    if (line.trim().startsWith("|")) {
+      const row = cells(line)
+      const command = row.findIndex((cell) => /^(?:sub)?command$/i.test(cell))
+      const description = row.findIndex((cell) => /^description$/i.test(cell))
+      if (command >= 0 && description >= 0) {
+        columns = { command, description }
+        continue
+      }
+      if (columns) {
+        const spec = row[columns.command]
+        if (spec) add(spec.replace(`/${name} `, ""), row[columns.description] ?? "")
+      }
+      continue
+    }
+    columns = undefined
+    for (const match of line.matchAll(/`([^`]+)`/g)) {
+      const prefix = `/${name} `
+      if (!match[1].startsWith(prefix)) continue
+      const description = plain(line.slice(match.index! + match[0].length)).replace(/^\s*[:.,;-]\s*/, "")
+      add(match[1].slice(prefix.length), description)
+    }
+  }
+  return {
+    ...(hint ? { usage: hint } : {}),
+    subcommands: [...subcommands.values()],
+  }
+}
