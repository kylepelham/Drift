diff --git a/packages/opencode/test/server/sse-backpressure.test.ts b/packages/opencode/test/server/sse-backpressure.test.ts
new file mode 100644
index 000000000..82c3a165f
--- /dev/null
+++ b/packages/opencode/test/server/sse-backpressure.test.ts
@@ -0,0 +1,46 @@
+import { expect, test } from "bun:test"
+import { Cause, Effect, Queue } from "effect"
+import * as Stream from "effect/Stream"
+import { EventV2 } from "@opencode-ai/core/event"
+
+const instance = await Bun.file(
+  new URL("../../src/server/routes/instance/httpapi/handlers/event.ts", import.meta.url),
+).text()
+const global = await Bun.file(
+  new URL("../../src/server/routes/instance/httpapi/handlers/global.ts", import.meta.url),
+).text()
+
+test("the instance event stream uses a bounded subscriber queue", () => {
+  expect(instance).toContain("EventV2.allBounded(events, subscriberCapacity)")
+  expect(instance).not.toContain("Queue.unbounded")
+  expect(instance).toContain("Stream.catchCause")
+})
+
+test("the global event stream bounds its buffer and disconnects on overflow", () => {
+  expect(global).toContain("{ bufferSize: subscriberCapacity, strategy: \"dropping\" }")
+  expect(global).toContain("Queue.failCauseUnsafe")
+  expect(global).toContain("EventV2.SubscriberOverflowError({ capacity: subscriberCapacity })")
+  expect(global).toContain("Stream.catchCause")
+})
+
+test("a stalled bounded subscriber fails with overflow instead of retaining events", async () => {
+  const capacity = 4
+  const consumed = await Effect.runPromise(
+    Effect.gen(function* () {
+      const queue = yield* Queue.dropping<number, EventV2.SubscriberOverflowError>(capacity)
+      for (let index = 0; index < capacity + 8; index++) {
+        const accepted = yield* Queue.offer(queue, index)
+        if (!accepted) {
+          yield* Queue.failCause(queue, Cause.fail(new EventV2.SubscriberOverflowError({ capacity })))
+          break
+        }
+      }
+      // The stream ends with the overflow failure after draining what was retained.
+      return yield* Stream.fromQueue(queue).pipe(
+        Stream.catchCause(() => Stream.empty),
+        Stream.runCollect,
+      )
+    }),
+  )
+  expect(consumed.length).toBeLessThanOrEqual(capacity)
+})
