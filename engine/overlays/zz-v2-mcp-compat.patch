diff --git a/packages/opencode/test/config/v2-mcp-compat.test.ts b/packages/opencode/test/config/v2-mcp-compat.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/opencode/test/config/v2-mcp-compat.test.ts
@@ -0,0 +1,102 @@
+import { expect, test } from "bun:test"
+import { ConfigV1 } from "@opencode-ai/core/v1/config/config"
+import { ConfigMCPV1 } from "@opencode-ai/core/v1/config/mcp"
+import { ConfigParse } from "../../src/config/parse"
+import { ConfigV2Compat } from "../../src/config/v2-compat"
+
+const source = "test:v2-mcp-compat"
+const oauth = {
+  clientId: "legacy-client",
+  clientSecret: "legacy-secret",
+  callbackPort: 19877,
+  redirectUri: "http://127.0.0.1:19877/callback",
+  scope: "read",
+}
+const remote = { type: "remote" as const, url: "https://example.com/mcp", oauth }
+const nativeOAuth = {
+  client_id: "native-client",
+  client_secret: "native-secret",
+  callback_port: 19878,
+  redirect_uri: "http://127.0.0.1:19878/callback",
+  scope: "read",
+}
+
+function lower(server: unknown) {
+  return (ConfigV2Compat.lower({ mcp: { docs: server } }, source).value as { mcp: { docs: unknown } }).mcp.docs
+}
+
+test("Drift preserves plain V1 MCP definitions through normalization and config decoding", () => {
+  const input = {
+    mcp: {
+      docs: { ...remote, enabled: false, timeout: 30000 },
+      automatic: { type: "remote" as const, url: remote.url },
+      anonymous: { type: "remote" as const, url: remote.url, oauth: false as const },
+      servers: { type: "local" as const, command: ["example-mcp"], environment: { MODE: "test" } },
+      timeout: { enabled: false },
+    },
+  }
+  const original = structuredClone(input)
+  const result = ConfigV2Compat.lower(input, source)
+  expect(result.diagnostics).toEqual([])
+  expect(ConfigParse.schema(ConfigV1.Info, result.value, source)).toEqual(input)
+  expect(input).toEqual(original)
+})
+
+test("Drift retains V1 OAuth when V2 server fields trigger normalization", () => {
+  for (const fields of [{ codemode: false }, { disabled: false }, { timeout: { catalog: 30000, execution: 30000 } }]) {
+    for (const enabled of [undefined, true, false]) {
+      const input = { ...remote, ...fields, ...(enabled === undefined ? {} : { enabled }) }
+      const original = structuredClone(input)
+      const result = ConfigParse.schema(ConfigMCPV1.Remote, lower(input), source)
+      expect(result).toEqual({
+        ...remote,
+        enabled: enabled ?? true,
+        ...("timeout" in fields ? { timeout: 30000 } : {}),
+      })
+      expect(input).toEqual(original)
+    }
+  }
+})
+
+test("Drift gives explicit V1 OAuth fields precedence over V2 equivalents", () => {
+  const legacy = { ...oauth, clientId: "", clientSecret: "", redirectUri: "" }
+  const input = { ...remote, enabled: false, disabled: false, oauth: { ...nativeOAuth, ...legacy } }
+  const original = structuredClone(input)
+  expect(ConfigParse.schema(ConfigMCPV1.Remote, lower(input), source)).toEqual({
+    ...remote,
+    enabled: false,
+    oauth: legacy,
+  })
+  expect(input).toEqual(original)
+})
+
+test("Drift still lowers V2 OAuth fields without explicit V1 equivalents", () => {
+  expect(ConfigParse.schema(ConfigMCPV1.Remote, lower({ ...remote, oauth: nativeOAuth }), source)).toEqual({
+    ...remote,
+    enabled: true,
+    oauth: {
+      clientId: nativeOAuth.client_id,
+      clientSecret: nativeOAuth.client_secret,
+      callbackPort: nativeOAuth.callback_port,
+      redirectUri: nativeOAuth.redirect_uri,
+      scope: nativeOAuth.scope,
+    },
+  })
+})
+
+test("Drift leaves invalid explicit V1 OAuth values for the V1 remote decoder to reject", () => {
+  const invalid = [
+    { clientId: null },
+    { clientSecret: 42 },
+    { redirectUri: false },
+    { callbackPort: 0 },
+    { callbackPort: 65536 },
+    { callbackPort: 1.5 },
+  ]
+  for (const fields of invalid) {
+    const result = lower({ ...remote, codemode: false, oauth: { ...nativeOAuth, ...fields } })
+    expect(result).toMatchObject({ oauth: fields })
+    // ConfigV1.Info also accepts enabled-only entries; validate the actual remote definition here.
+    expect(() => ConfigParse.schema(ConfigMCPV1.Remote, result, source)).toThrow("ConfigInvalidError")
+  }
+})
