+    expect(yield* question.list()).toHaveLength(1)
+    const changed = yield* question.reply({ requestID: request.id, answers: [["Red"]] }).pipe(Effect.exit)
+    expect(Exit.isFailure(changed)).toBe(true)
+    expect(deliveries).toHaveLength(1)
+    yield* question.reply({ requestID: request.id, answers: [["Blue"]] })
+    expect(deliveries).toHaveLength(2)
+    expect(deliveries[0]).toEqual(deliveries[1])
+    expect(yield* question.list()).toEqual([])
+  }),
+)
+
+it.instance("async rejection never admits an answer or restarts a stopped session", () =>
+  Effect.gen(function* () {
+    const question = yield* Question.Service
+    const request = yield* question.register({
+      sessionID,
+      questions,
