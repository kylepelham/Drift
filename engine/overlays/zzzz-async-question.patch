+import { expect } from "bun:test"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { Cause, Deferred, Effect, Exit, Fiber, Schema } from "effect"
+import { Question } from "../../src/question"
+import { QuestionID } from "../../src/question/schema"
+import { QuestionTool, Parameters } from "../../src/tool/question"
+import { SessionID, MessageID } from "../../src/session/schema"
+import { EventV2Bridge } from "../../src/event-v2-bridge"
+import { Truncate } from "../../src/tool/truncate"
+import { Agent } from "../../src/agent/agent"
+import { awaitWithTimeout, testEffect } from "../lib/effect"
+
+const it = testEffect(
+  LayerNode.compile(LayerNode.group([Question.node, EventV2Bridge.node, Truncate.node, Agent.node])),
+)
+const questions = [{ question: "Which color?", header: "Color", options: [{ label: "Blue", description: "Blue" }] }]
+const sessionID = SessionID.make("ses_async-question")
+const ctx = {
+  sessionID,
+  messageID: MessageID.make("msg_async-question"),
+  callID: "call-question",
+  agent: "plan",
+  abort: AbortSignal.any([]),
+  messages: [],
+  metadata: () => Effect.void,
+  ask: () => Effect.die("Question must not grant permissions"),
+}
+
+it.instance("async question tool defaults to immediate return and a wire-visible pending request", () =>
+  Effect.gen(function* () {
+    const question = yield* Question.Service
+    const info = yield* QuestionTool
+    const tool = yield* info.init()
+    const received: Question.Delivery[] = []
+    const result = yield* tool.execute(
+      { questions },
+      {
+        ...ctx,
+        extra: {
+          promptOps: {
+            answerQuestion: (input: Question.Delivery) =>
+              Effect.sync(() => {
+                received.push(input)
+              }),
+          },
+        },
+      },
+    )
+    const pending = yield* question.list()
+    expect(pending).toHaveLength(1)
+    expect(pending[0]).toMatchObject({
+      id: result.metadata.requestID,
+      sessionID,
+      async: true,
+      tool: { messageID: ctx.messageID, callID: ctx.callID },
+    })
+    expect(Schema.decodeUnknownSync(Question.Request)(pending[0]).async).toBe(true)
+    expect(Schema.decodeUnknownSync(Parameters)({ questions, async: false }).async).toBe(false)
+    expect(result.output).toContain("NOT answered")
+    expect(result.metadata.answers).toBeUndefined()
+    expect(received).toHaveLength(0)
+    yield* question.reply({ requestID: pending[0].id, answers: [["Blue"]] })
+    expect(received).toHaveLength(1)
+    expect(received[0].request.sessionID).toBe(sessionID)
+    expect(yield* question.list()).toEqual([])
+    const duplicate = yield* question.reply({ requestID: pending[0].id, answers: [["Blue"]] }).pipe(Effect.exit)
+    expect(Exit.isFailure(duplicate)).toBe(true)
+    if (Exit.isFailure(duplicate)) expect(Cause.squash(duplicate.cause)).toBeInstanceOf(Question.NotFoundError)
+    expect(received).toHaveLength(1)
+  }),
+)
+
+it.instance("async reply retains the card until admission and serializes concurrent duplicates", () =>
+  Effect.gen(function* () {
+    const question = yield* Question.Service
+    const entered = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    let calls = 0
+    const request = yield* question.register({
+      sessionID,
+      questions,
+      deliver: () =>
+        Effect.gen(function* () {
+          calls++
+          yield* Deferred.succeed(entered, undefined)
+          yield* Deferred.await(release)
+        }),
+    })
+    const first = yield* question.reply({ requestID: request.id, answers: [["Blue"]] }).pipe(Effect.forkChild)
+    yield* Deferred.await(entered)
+    expect(yield* question.list()).toHaveLength(1)
+    const duplicate = yield* question
+      .reply({ requestID: request.id, answers: [["Blue"]] })
+      .pipe(Effect.exit, Effect.forkChild)
+    yield* Deferred.succeed(release, undefined)
+    yield* Fiber.join(first)
+    const exit = yield* Fiber.join(duplicate)
+    expect(Exit.isFailure(exit)).toBe(true)
+    expect(calls).toBe(1)
+    expect(yield* question.list()).toEqual([])
+  }),
+)
+
+it.instance("async admission failures retain the request and retry stable IDs and original answers", () =>
+  Effect.gen(function* () {
+    const question = yield* Question.Service
+    const deliveries: Question.Delivery[] = []
+    const request = yield* question.register({
+      sessionID,
+      questions,
+      deliver: (input) =>
+        Effect.gen(function* () {
+          deliveries.push(input)
+          if (deliveries.length === 1) return yield* Effect.die(new Error("admission unavailable"))
+        }),
+    })
