+        expect(Exit.isSuccess(exit)).toBe(answer === "Yes")
+        const messages = yield* sessions.messages({ sessionID: chat.id })
+        expect(messages).toHaveLength(answer === "Yes" ? 2 : 1)
+        if (answer === "Yes") expect(messages[1].info).toMatchObject({ role: "user", agent: "build", model: ref })
+        expect((yield* sessions.get(chat.id)).permission).toEqual(chat.permission)
+      }),
+    { config: cfg },
+  )
+
+it.instance("async question retry after committed admission reuses its message and latest switched selection", () =>
+  Effect.gen(function* () {
+    const { llm } = yield* useServerConfig(providerCfg)
+    const prompt = yield* SessionPrompt.Service
+    const sessions = yield* Session.Service
+    const question = yield* Question.Service
+    const status = yield* SessionStatus.Service
+    const runState = yield* SessionRunState.Service
+    const chat = yield* sessions.create({ title: "Pinned" })
+    const original = yield* prompt.prompt({
+      sessionID: chat.id,
+      agent: "plan",
+      model: ref,
+      noReply: true,
+      parts: [{ type: "text", text: "Initial" }],
+    })
+    if (original.info.role !== "user") return yield* Effect.die("Expected a user")
+    // The retry overlay changes the latest user/assistant model before session metadata.
+    yield* sessions.updateMessage({ ...original.info, model: { ...ref, variant: "switched" } })
+    const entered = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    const active = yield* runState
+      .ensureRunning(
+        chat.id,
+        Effect.succeed(original),
+        Effect.gen(function* () {
+          yield* Deferred.succeed(entered, undefined)
+          yield* Deferred.await(release)
+          return original
+        }),
+      )
+      .pipe(Effect.forkChild)
+    yield* Deferred.await(entered)
+    let attempts = 0
+    const request = yield* question.register({
+      sessionID: chat.id,
+      questions: [
+        { header: "Color", question: "Which colors?", options: [], multiple: true },
+        { header: "Notes", question: "Any notes?", options: [] },
+        { header: "Missing", question: "Anything else?", options: [] },
+      ],
+      deliver: (input) =>
+        Effect.gen(function* () {
+          yield* prompt.answerQuestion(input)
+          if (++attempts === 1) return yield* Effect.die("Failure after durable admission")
+        }),
+    })
+    const answers = [["Blue", "Green, teal"], ["Keep raw\ntext <unchanged>"]]
+    const metadata = {
+      driftClarification: {
+        version: 1,
+        requestID: request.id,
+        items: [
+          { header: "Color", question: "Which colors?", answers: ["Blue", "Green, teal"] },
+          { header: "Notes", question: "Any notes?", answers: ["Keep raw\ntext <unchanged>"] },
+          { header: "Missing", question: "Anything else?", answers: [] },
+        ],
+      },
+    }
+    const failed = yield* question.reply({ requestID: request.id, answers }).pipe(Effect.exit)
+    expect(Exit.isFailure(failed)).toBe(true)
+    expect(yield* question.list()).toHaveLength(1)
+    const committed = (yield* sessions.messages({ sessionID: chat.id }))[1]
+    expect(committed.parts[0]).toHaveProperty("metadata", metadata)
+    yield* question.reply({ requestID: request.id, answers })
+    expect(yield* question.list()).toEqual([])
+    const messages = yield* sessions.messages({ sessionID: chat.id })
+    expect(messages).toHaveLength(2)
+    expect(messages[1].info).toMatchObject({ role: "user", agent: "plan", model: { ...ref, variant: "switched" } })
+    expect(messages[1]).toEqual(committed)
+    expect(messages[1].parts[0]).toMatchObject({
+      type: "text",
+      text: `Answer to clarification ${request.id}:\nWhich colors?\nBlue, Green, teal\n\nAny notes?\nKeep raw\ntext <unchanged>\n\nAnything else?\nUnanswered`,
+      metadata,
+    })
+    expect(messages[1].parts[0]).not.toHaveProperty("synthetic", true)
+    yield* llm.text("Handled once")
+    yield* Deferred.succeed(release, undefined)
+    yield* Fiber.join(active)
+    yield* llm.wait(1)
+    yield* pollWithTimeout(
+      status.get(chat.id).pipe(Effect.map((value) => (value.type === "idle" ? true : undefined))),
+      "retry successor did not finish",
+    )
+    expect(yield* llm.calls).toBe(1)
+    const store = yield* InstanceStore.Service
+    const { directory } = yield* TestInstance
+    const reloaded = yield* store.reload({ directory })
+    const history = yield* sessions.messages({ sessionID: chat.id }).pipe(Effect.provideService(InstanceRef, reloaded))
+    expect(history.filter((message) => message.info.id === committed.info.id)).toEqual([committed])
+    const provider = yield* ProviderSvc.Service
+    const model = yield* provider.getModel(ref.providerID, ref.modelID)
+    const converted = yield* MessageV2.toModelMessagesEffect(
+      [history.find((message) => message.info.id === committed.info.id)!],
+      model,
+    )
+    expect(converted).toEqual([
+      { role: "user", content: [{ type: "text", text: (committed.parts[0] as SessionV1.TextPart).text }] },
+    ])
+  }),
+)
