@@ -0,0 +1,269 @@
+import { expect } from "bun:test"
+import { Cause, Deferred, Effect, Exit, Fiber, Scope } from "effect"
+import { Runner } from "../../src/effect/runner"
+import { it } from "../lib/effect"
+
+for (const failed of [false, true])
+  for (const hook of ["defect", "interrupt"])
+    it.live(
+      `question runner settles ${failed ? "failed" : "successful"} work after idle hook ${hook}`,
+      Effect.gen(function* () {
+        const scope = yield* Scope.Scope
+        const runner = Runner.make<string, string>(scope, {
+          onIdle: hook === "defect" ? Effect.die("idle failed") : Effect.interrupt,
+        })
+        const result = yield* runner
+          .ensureRunning(failed ? Effect.fail("work failed") : Effect.succeed("work result"))
+          .pipe(Effect.exit, Effect.timeout("2 seconds"))
+        expect(runner.state._tag).toBe("Idle")
+        expect(Exit.isFailure(result)).toBe(failed)
+        if (Exit.isFailure(result)) expect(Cause.squash(result.cause)).toBe("work failed")
+        else expect(result.value).toBe("work result")
+        expect(yield* runner.ensureRunning(Effect.succeed("next prompt")).pipe(Effect.timeout("2 seconds"))).toBe(
+          "next prompt",
+        )
+        expect(runner.busy).toBe(false)
+      }),
+    )
+
+for (const hook of ["onCancel", "onIdle"] as const)
+  it.live(
+    `question cancellation still stops work when ${hook} fails`,
+    Effect.gen(function* () {
+      const scope = yield* Scope.Scope
+      const runner = Runner.make<string>(scope, {
+        onInterrupt: Effect.succeed("cancelled"),
+        [hook]: Effect.die("cleanup failed"),
+      })
+      const entered = yield* Deferred.make<void>()
+      let finalized = false
+      const run = yield* runner
+        .ensureRunning(
+          Deferred.succeed(entered, undefined).pipe(
+            Effect.andThen(Effect.never),
+            Effect.ensuring(
+              Effect.sync(() => {
+                finalized = true
+              }),
+            ),
+          ),
+        )
+        .pipe(Effect.forkChild)
+      yield* Deferred.await(entered)
+      expect(Exit.isFailure(yield* runner.cancel.pipe(Effect.exit))).toBe(true)
+      expect(yield* Fiber.join(run)).toBe("cancelled")
+      expect(finalized).toBe(true)
+      expect(runner.busy).toBe(false)
+    }),
+  )
+
+for (const stop of ["failure", "terminal"])
+  it.live(
+    `question wake drops queued and inflight work after ${stop}`,
+    Effect.gen(function* () {
+      const scope = yield* Scope.Scope
+      const runner = Runner.make<string, string>(scope)
+      const entered = yield* Deferred.make<void>()
+      const release = yield* Deferred.make<void>()
+      let calls = 0
+      const work = Effect.sync(() => {
+        calls++
+        return "wake"
+      })
+      const first = yield* runner
+        .ensureRunning(
+          Effect.gen(function* () {
+            yield* Deferred.succeed(entered, undefined)
+            yield* Deferred.await(release)
+            if (stop === "failure") return yield* Effect.fail("failed")
+            yield* runner.suppressWake
+            return "denied"
+          }),
+        )
+        .pipe(Effect.exit, Effect.forkChild)
+      yield* Deferred.await(entered)
+      const inflight = runner.wake(work)
+      yield* runner.wake(work)
+      yield* Deferred.succeed(release, undefined)
+      const exit = yield* Fiber.join(first)
+      expect(Exit.isFailure(exit)).toBe(stop === "failure")
+      yield* inflight
+      expect(calls).toBe(0)
+      expect(runner.busy).toBe(false)
+      expect(yield* runner.ensureRunning(Effect.succeed("explicit"))).toBe("explicit")
+    }),
+  )
+
+it.live(
+  "question wake cannot restart during cancellation cleanup or from a stale admission",
+  Effect.gen(function* () {
+    const scope = yield* Scope.Scope
+    const runner = Runner.make<string>(scope, { onInterrupt: Effect.succeed("cancelled") })
+    const entered = yield* Deferred.make<void>()
+    const finalizing = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    let calls = 0
+    const work = Effect.sync(() => {
+      calls++
+      return "wake"
+    })
+    yield* Effect.gen(function* () {
+      const first = yield* runner
+        .ensureRunning(
+          Deferred.succeed(entered, undefined).pipe(
+            Effect.andThen(Effect.never),
+            Effect.ensuring(Deferred.succeed(finalizing, undefined).pipe(Effect.andThen(Deferred.await(release)))),
+          ),
+        )
+        .pipe(Effect.forkChild)
+      yield* Deferred.await(entered)
+      const inflight = runner.wake(work)
+      yield* runner.wake(work)
+      const cancel = yield* runner.cancel.pipe(Effect.forkChild)
+      yield* Deferred.await(finalizing)
+      expect(runner.state._tag).toBe("Cancelling")
+      expect(runner.busy).toBe(true)
+      const during = runner.wake(work)
+      yield* runner.wake(work)
+      yield* inflight
+      expect(calls).toBe(0)
+      const secondCancel = yield* runner.cancel.pipe(Effect.forkChild)
+      yield* Deferred.succeed(release, undefined)
+      yield* Fiber.join(cancel)
+      yield* Fiber.join(secondCancel)
+      expect(yield* Fiber.join(first)).toBe("cancelled")
+      yield* inflight
+      yield* during
+      expect(calls).toBe(0)
+      expect(runner.busy).toBe(false)
+    }).pipe(Effect.ensuring(Deferred.succeed(release, undefined)))
+  }),
+)
+
+it.live(
+  "question wake does not abort active work and coalesces a serialized successor",
+  Effect.gen(function* () {
+    const scope = yield* Scope.Scope
+    const runner = Runner.make<string>(scope)
+    const entered = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    const woke = yield* Deferred.make<void>()
+    const order: string[] = []
+    const first = yield* runner
+      .ensureRunning(
+        Effect.gen(function* () {
+          order.push("active")
+          yield* Deferred.succeed(entered, undefined)
+          yield* Deferred.await(release)
+          order.push("finished")
+          return "first"
+        }),
+      )
+      .pipe(Effect.forkChild)
+    yield* Deferred.await(entered)
+    const work = Effect.sync(() => {
+      order.push("successor")
+      return "next"
+    }).pipe(Effect.tap(() => Deferred.succeed(woke, undefined)))
+    yield* runner.wake(work)
+    yield* runner.wake(work)
+    expect(order).toEqual(["active"])
+    yield* Deferred.succeed(release, undefined)
+    expect(yield* Fiber.join(first)).toBe("first")
+    yield* Deferred.await(woke)
+    expect(order).toEqual(["active", "finished", "successor"])
+  }),
+)
+
+it.live(
+  "question wake arriving during the final idle transition is not lost",
+  Effect.gen(function* () {
+    const scope = yield* Scope.Scope
+    const exiting = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    const woke = yield* Deferred.make<void>()
+    let idles = 0
+    const runner = Runner.make<string>(scope, {
+      onIdle: Effect.gen(function* () {
+        if (++idles !== 1) return
+        yield* Deferred.succeed(exiting, undefined)
+        yield* Deferred.await(release)
+      }),
+    })
+    const first = yield* runner.ensureRunning(Effect.succeed("finished")).pipe(Effect.forkChild)
+    yield* Deferred.await(exiting)
+    const wake = yield* runner.wake(Deferred.succeed(woke, undefined).pipe(Effect.as("answer"))).pipe(Effect.forkChild)
+    yield* Deferred.succeed(release, undefined)
+    yield* Fiber.join(first)
+    yield* Fiber.join(wake)
+    yield* Deferred.await(woke)
+  }),
+)
+
+it.live(
+  "question wake cancellation drops a queued successor instead of restarting",
+  Effect.gen(function* () {
+    const scope = yield* Scope.Scope
+    const runner = Runner.make<string>(scope, { onInterrupt: Effect.succeed("cancelled") })
+    const entered = yield* Deferred.make<void>()
+    let woke = false
+    const first = yield* runner
+      .ensureRunning(Deferred.succeed(entered, undefined).pipe(Effect.andThen(Effect.never)))
+      .pipe(Effect.forkChild)
+    yield* Deferred.await(entered)
+    yield* runner.wake(
+      Effect.sync(() => {
+        woke = true
+        return "bad"
+      }),
+    )
+    yield* runner.cancel
+    expect(yield* Fiber.join(first)).toBe("cancelled")
+    expect(woke).toBe(false)
+    expect(runner.busy).toBe(false)
+  }),
+)
+
+it.live(
+  "question wake waits for a shell and its already queued run",
+  Effect.gen(function* () {
+    const scope = yield* Scope.Scope
+    const runner = Runner.make<string>(scope)
+    const entered = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    const woke = yield* Deferred.make<void>()
+    const order: string[] = []
+    const shell = yield* runner
+      .startShell(
+        Effect.gen(function* () {
+          yield* Deferred.succeed(entered, undefined)
+          yield* Deferred.await(release)
+          order.push("shell")
+          return "shell"
+        }),
+      )
+      .pipe(Effect.forkChild)
+    yield* Deferred.await(entered)
+    const queued = yield* runner
+      .ensureRunning(
+        Effect.sync(() => {
+          order.push("queued")
+          return "queued"
+        }),
+      )
+      .pipe(Effect.forkChild)
+    while (runner.state._tag !== "ShellThenRun") yield* Effect.yieldNow
+    yield* runner.wake(
+      Effect.sync(() => {
+        order.push("wake")
+        return "wake"
+      }).pipe(Effect.tap(() => Deferred.succeed(woke, undefined))),
+    )
+    expect(order).toEqual([])
+    yield* Deferred.succeed(release, undefined)
+    yield* Fiber.join(shell)
+    yield* Fiber.join(queued)
+    yield* Deferred.await(woke)
+    expect(order).toEqual(["shell", "queued", "wake"])
+  }),
+)
