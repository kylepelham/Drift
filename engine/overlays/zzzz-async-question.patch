+    expect(yield* question.list()).toEqual([])
+    const exit = yield* question.reply({ requestID: request.id, answers: [["Blue"]] }).pipe(Effect.exit)
+    expect(Exit.isFailure(exit)).toBe(true)
+    const unknown = yield* question.reply({ requestID: QuestionID.make("que_unknown"), answers: [] }).pipe(Effect.exit)
+    expect(Exit.isFailure(unknown)).toBe(true)
+  }),
+)
+
+for (const failure of ["defect", "interrupt"]) {
+  it.instance(`blocking rejection settles the caller despite a rejected notification ${failure}`, () =>
+    Effect.gen(function* () {
+      const question = yield* Question.Service
+      const events = yield* EventV2Bridge.Service
+      const asked = yield* Deferred.make<Question.Request>()
+      let notifications = 0
+      const off = yield* events.listen((event) => {
+        if (event.type === Question.Event.Asked.type)
+          return Deferred.succeed(asked, event.data as Question.Request).pipe(Effect.asVoid)
+        if (event.type !== Question.Event.Rejected.type) return Effect.void
+        notifications++
+        return failure === "defect" ? Effect.die("rejected listener failed") : Effect.interrupt
+      })
+      yield* Effect.addFinalizer(() => off)
+      const caller = yield* question.ask({ sessionID, questions }).pipe(Effect.exit, Effect.forkChild)
+      const request = yield* awaitWithTimeout(Deferred.await(asked), "blocking question was not published")
+      expect(yield* question.list()).toEqual([request])
+      const rejected = yield* question.reject(request.id).pipe(Effect.exit)
+      expect(Exit.isSuccess(rejected)).toBe(true)
+      expect(notifications).toBe(1)
+      expect(yield* question.list()).toEqual([])
+      const exit = yield* awaitWithTimeout(Fiber.join(caller), "rejected caller did not settle")
+      expect(Exit.isFailure(exit)).toBe(true)
+      if (Exit.isFailure(exit)) expect(Cause.squash(exit.cause)).toBeInstanceOf(Question.RejectedError)
+      const duplicate = yield* question.reject(request.id).pipe(Effect.exit)
+      expect(Exit.isFailure(duplicate)).toBe(true)
+      if (Exit.isFailure(duplicate)) expect(Cause.squash(duplicate.cause)).toBeInstanceOf(Question.NotFoundError)
+      expect(notifications).toBe(1)
+    }),
+  )
+
+  it.instance(`blocking ask removes its pending request after an asked publication ${failure}`, () =>
+    Effect.gen(function* () {
+      const question = yield* Question.Service
+      const events = yield* EventV2Bridge.Service
+      const published: Question.Request[] = []
+      const defect = new Error("asked listener failed")
+      const off = yield* events.listen((event) => {
+        if (event.type !== Question.Event.Asked.type) return Effect.void
+        published.push(event.data as Question.Request)
+        return failure === "defect" ? Effect.die(defect) : Effect.interrupt
+      })
+      yield* Effect.addFinalizer(() => off)
+      const exit = yield* question.ask({ sessionID, questions }).pipe(Effect.exit)
+      expect(Exit.isFailure(exit)).toBe(true)
+      if (Exit.isFailure(exit)) {
+        if (failure === "defect") expect(Cause.squash(exit.cause)).toBe(defect)
+        else expect(Cause.hasInterruptsOnly(exit.cause)).toBe(true)
+      }
+      expect(published).toHaveLength(1)
+      expect(yield* question.list()).toEqual([])
+      const reply = yield* question.reply({ requestID: published[0].id, answers: [["Blue"]] }).pipe(Effect.exit)
+      expect(Exit.isFailure(reply)).toBe(true)
+      if (Exit.isFailure(reply)) expect(Cause.squash(reply.cause)).toBeInstanceOf(Question.NotFoundError)
+      yield* off
+      const asked = yield* Deferred.make<Question.Request>()
+      const unsubscribe = yield* events.listen((event) =>
+        event.type === Question.Event.Asked.type
+          ? Deferred.succeed(asked, event.data as Question.Request).pipe(Effect.asVoid)
+          : Effect.void,
+      )
+      yield* Effect.addFinalizer(() => unsubscribe)
+      const caller = yield* question.ask({ sessionID, questions }).pipe(Effect.forkChild)
+      const request = yield* awaitWithTimeout(Deferred.await(asked), "next question was not published")
+      yield* question.reply({ requestID: request.id, answers: [["Blue"]] })
+      expect(yield* awaitWithTimeout(Fiber.join(caller), "next question did not settle")).toEqual([["Blue"]])
+      expect(yield* question.list()).toEqual([])
+    }),
+  )
+}
+
+it.instance("async false preserves blocking tool execution without promptOps", () =>
+  Effect.gen(function* () {
+    const question = yield* Question.Service
+    const info = yield* QuestionTool
+    const tool = yield* info.init()
+    const asked = yield* Deferred.make<Question.Request>()
+    const events = yield* EventV2Bridge.Service
+    const off = yield* events.listen((event) =>
+      event.type === Question.Event.Asked.type
+        ? Deferred.succeed(asked, event.data as Question.Request).pipe(Effect.asVoid)
+        : Effect.void,
+    )
+    yield* Effect.addFinalizer(() => off)
+    const finished = yield* Deferred.make<void>()
+    const fiber = yield* tool.execute({ questions, async: false }, ctx).pipe(
+      Effect.tap(() => Deferred.succeed(finished, undefined)),
+      Effect.forkChild,
+    )
+    const request = yield* Deferred.await(asked)
