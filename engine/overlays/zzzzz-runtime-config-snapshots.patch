diff --git a/packages/opencode/src/effect/runtime-config.ts b/packages/opencode/src/effect/runtime-config.ts
new file mode 100644
index 0000000..1b0f0d3
--- /dev/null
+++ b/packages/opencode/src/effect/runtime-config.ts
@@ -0,0 +1,104 @@
+import { Context, Effect, Scope, ScopedCache } from "effect"
+
+export interface Revision {
+  readonly id: number
+  readers: number
+  retired: boolean
+  closed: boolean
+  readonly finalizers: Set<Effect.Effect<void>>
+}
+
+const revision = (id: number): Revision => ({ id, readers: 0, retired: false, closed: false, finalizers: new Set() })
+let latest = revision(0)
+
+export const Ref = Context.Reference<Revision | undefined>("@drift/RuntimeConfig", { defaultValue: () => undefined })
+export const current = Effect.map(Ref, (value) => value ?? latest)
+
+const collect = (value: Revision) =>
+  Effect.suspend(() => {
+    if (!value.retired || value.readers !== 0 || value.closed) return Effect.void
+    value.closed = true
+    const finalizers = [...value.finalizers]
+    value.finalizers.clear()
+    return Effect.forEach(
+      finalizers,
+      (finalizer) => finalizer.pipe(Effect.catchCause((cause) => Effect.logError("retired config cleanup failed", { cause }))),
+      { discard: true },
+    )
+  })
+
+const retain = (value: Revision) => {
+  // Retain synchronously because publication can race admission.
+  if (value.closed) throw new Error("Runtime config snapshot has already been released")
+  value.readers++
+  return value
+}
+
+const acquire = Effect.map(current, retain)
+
+const release = (value: Revision) =>
+  Effect.suspend(() => {
+    value.readers--
+    return collect(value)
+  })
+
+/** Keep a captured revision available only while a deferred callback is running. */
+export const withRevision = <A, E, R>(value: Revision, work: Effect.Effect<A, E, R>) =>
+  Effect.suspend(() => value.closed ? Effect.interrupt : use(work).pipe(Effect.provideService(Ref, value)))
+
+/** Pin resources for the entire operation, including model turns, tools and approval waits. */
+export const use = <A, E, R>(work: Effect.Effect<A, E, R>): Effect.Effect<A, E, R> =>
+  Effect.acquireUseRelease(acquire, (value) => work.pipe(Effect.provideService(Ref, value)), release)
+
+/** A newly admitted runner selects the latest snapshot independently of every other session. */
+export const run = <A, E, R>(work: Effect.Effect<A, E, R>) => use(work).pipe(Effect.provideService(Ref, undefined))
+
+export const method = <Args extends unknown[], A, E, R>(fn: (...args: Args) => Effect.Effect<A, E, R>) =>
+  (...args: Args) => use(Effect.suspend(() => fn(...args)))
+
+/** Acquire before forking so a detached child cannot lose its parent's resources before it starts. */
+export const forkIn = (scope: Scope.Scope) => <A, E, R>(work: Effect.Effect<A, E, R>) =>
+  Effect.uninterruptibleMask((restore) =>
+    Effect.gen(function* () {
+      const lease = yield* Scope.fork(scope)
+      const value = yield* acquire
+      // A closed parent may reject a fork before the work's own finalizers can run.
+      yield* Scope.addFinalizer(lease, release(value))
+      return yield* restore(work).pipe(
+        Effect.provideService(Ref, value),
+        Effect.onExit((exit) => Scope.close(lease, exit)),
+        Effect.forkIn(scope),
+      )
+    }),
+  )
+
+/** Publishing never waits for active readers. Only retired resources wait for their final reader. */
+export const refresh = Effect.uninterruptible(
+  Effect.suspend(() => {
+    const previous = latest
+    latest = revision(previous.id + 1)
+    previous.retired = true
+    return collect(previous)
+  }),
+)
+
+export const onRetire = (finalizer: Effect.Effect<void>) =>
+  Effect.gen(function* () {
+    const value = yield* current
+    value.finalizers.add(finalizer)
+    yield* Effect.addFinalizer(() => Effect.sync(() => { value.finalizers.delete(finalizer) }))
+  })
+
+/** Generation-scoped global data, such as the parsed global config. */
+export const cached = <A, E, R>(load: Effect.Effect<A, E, R>) => Effect.gen(function* () {
+  const cache: ScopedCache.ScopedCache<number, A, E, R> = yield* ScopedCache.make({
+    capacity: Number.POSITIVE_INFINITY,
+    lookup: (key: number) => Effect.gen(function* () {
+      yield* onRetire(ScopedCache.invalidate(cache, key))
+      return yield* load
+    }),
+  })
+  return use(Effect.flatMap(current, (value) => ScopedCache.get(cache, value.id)))
+})
+
+export * as RuntimeConfig from "./runtime-config"
