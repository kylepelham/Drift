diff --git a/packages/opencode/test/effect/runtime-config.test.ts b/packages/opencode/test/effect/runtime-config.test.ts
new file mode 100644
index 0000000..4414341
--- /dev/null
+++ b/packages/opencode/test/effect/runtime-config.test.ts
@@ -0,0 +1,179 @@
+import path from "node:path"
+import { expect } from "bun:test"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { CrossSpawnSpawner } from "@opencode-ai/core/cross-spawn-spawner"
+import { Deferred, Effect, Exit, Fiber, Layer, Scope } from "effect"
+import { Config } from "../../src/config/config"
+import { Skill } from "../../src/skill"
+import { Command } from "../../src/command"
+import { EffectBridge } from "../../src/effect/bridge"
+import { InstanceState } from "../../src/effect/instance-state"
+import { RuntimeConfig } from "../../src/effect/runtime-config"
+import { Runner } from "../../src/effect/runner"
+import { TestInstance, provideInstance, tmpdirScoped } from "../fixture/fixture"
+import { testEffect } from "../lib/effect"
+
+const it = testEffect(LayerNode.compile(LayerNode.group([Config.node, Skill.node, Command.node, CrossSpawnSpawner.node])))
+const unit = testEffect(Layer.empty)
+
+it.instance("running sessions retain skills and config while each idle session adopts the latest edit", () => Effect.gen(function* () {
+  const config = yield* Config.Service
+  const skill = yield* Skill.Service
+  const command = yield* Command.Service
+  const test = yield* TestInstance
+  const scope = yield* Scope.Scope
+  const other = yield* tmpdirScoped()
+  const write = (directory: string, version: string) => Effect.promise(async () => {
+    await Bun.write(path.join(directory, "opencode.json"), JSON.stringify({ username: version, command: { check: { template: version } } }))
+    await Bun.write(path.join(directory, ".opencode/skills/reload-test/SKILL.md"), `---\nname: reload-test\ndescription: ${version}\n---\n${version}\n`)
+  })
+  yield* write(test.directory, "first")
+  yield* write(other, "other-first")
+  const snapshot = Effect.gen(function* () {
+    const item = yield* command.get("check")
+    return {
+      username: (yield* config.get()).username,
+      skill: (yield* skill.require("reload-test").pipe(Effect.orDie)).content.trim(),
+      command: item ? yield* Effect.promise(() => Promise.resolve(item.template)) : undefined,
+    }
+  })
+  type Snapshot = Effect.Success<typeof snapshot>
+  const start = (directory: string) => Effect.gen(function* () {
+    const ready = yield* Deferred.make<Snapshot>()
+    const finish = yield* Deferred.make<void>()
+    const runner = Runner.make<Snapshot>(scope)
+    const fiber = yield* provideInstance(directory)(runner.ensureRunning(Effect.gen(function* () {
+      const before = yield* snapshot
+      yield* Deferred.succeed(ready, before)
+      yield* Deferred.await(finish)
+      expect(yield* snapshot).toEqual(before)
+      return before
+    }))).pipe(Effect.forkScoped)
+    return { runner, fiber, finish, before: yield* Deferred.await(ready) }
+  })
+  const first = yield* start(test.directory)
+  const second = yield* start(test.directory)
+  const third = yield* start(other)
+  expect(first.before).toEqual({ username: "first", skill: "first", command: "first" })
+  yield* write(test.directory, "second")
+  yield* write(other, "other-second")
+  yield* config.reload()
+  expect(first.runner.busy && second.runner.busy && third.runner.busy).toBe(true)
+  expect((yield* skill.require("reload-test")).content.trim()).toBe("second")
+  yield* Deferred.succeed(first.finish, undefined)
+  yield* Fiber.join(first.fiber)
+  expect(second.runner.busy && third.runner.busy).toBe(true)
+  expect(yield* first.runner.ensureRunning(snapshot)).toEqual({ username: "second", skill: "second", command: "second" })
+  yield* write(test.directory, "third")
+  yield* config.reload()
+  yield* Deferred.succeed(second.finish, undefined)
+  yield* Fiber.join(second.fiber)
+  expect(third.runner.busy).toBe(true)
+  expect(yield* second.runner.ensureRunning(snapshot)).toEqual({ username: "third", skill: "third", command: "third" })
+  yield* Deferred.succeed(third.finish, undefined)
+  yield* Fiber.join(third.fiber)
+  expect(yield* provideInstance(other)(third.runner.ensureRunning(snapshot))).toEqual({ username: "other-second", skill: "other-second", command: "other-second" })
+}))
+
+unit.instance("reload retains active resources and persistent instance state, then releases retired generations", () => Effect.gen(function* () {
+  const scope = yield* Scope.Scope
+  const closed: number[] = []
+  const resources = yield* InstanceState.makeReloadable(() => Effect.gen(function* () {
+    const value = (yield* RuntimeConfig.current).id
+    yield* Effect.addFinalizer(() => Effect.sync(() => { closed.push(value) }))
+    return value
+  }))
+  const persistent = yield* InstanceState.make(() => Effect.succeed({ pending: "approval" }))
+  const initial = yield* InstanceState.get(persistent)
+  const ready = yield* Deferred.make<number>()
+  const finish = yield* Deferred.make<void>()
+  const runner = Runner.make<number>(scope)
+  const first = yield* runner.ensureRunning(Effect.gen(function* () {
+    const before = yield* InstanceState.get(resources)
+    yield* Deferred.succeed(ready, before)
+    yield* Deferred.await(finish)
+    expect(yield* InstanceState.get(resources)).toBe(before)
+    return before
+  })).pipe(Effect.forkScoped)
+  const old = yield* Deferred.await(ready)
+  for (let i = 0; i < 20; i++) yield* RuntimeConfig.refresh
+  const fresh = yield* InstanceState.get(resources)
+  expect(fresh).toBeGreaterThan(old)
+  expect(closed).not.toContain(old)
+  expect(yield* InstanceState.get(persistent)).toBe(initial)
+  yield* Deferred.succeed(finish, undefined)
+  yield* Fiber.join(first)
+  expect(closed).toEqual([old])
+  expect(yield* runner.ensureRunning(InstanceState.get(resources))).toBe(fresh)
+}))
+
+unit.instance("detached follow-up work keeps its snapshot alive beyond the main runner", () => Effect.gen(function* () {
+  const scope = yield* Scope.Scope
+  const ready = yield* Deferred.make<RuntimeConfig.Revision>()
+  const finish = yield* Deferred.make<void>()
+  const child = yield* RuntimeConfig.run(Effect.gen(function* () {
+    const revision = yield* RuntimeConfig.current
+    return yield* Effect.gen(function* () {
+      yield* Deferred.succeed(ready, revision)
+      yield* Deferred.await(finish)
+      expect((yield* RuntimeConfig.current).closed).toBe(false)
+    }).pipe(RuntimeConfig.forkIn(scope))
+  }))
+  const old = yield* Deferred.await(ready)
+  yield* RuntimeConfig.refresh
+  expect(old.closed).toBe(false)
+  yield* Deferred.succeed(finish, undefined)
+  yield* Fiber.join(child)
+  expect(old.closed).toBe(true)
+}))
+
+unit.instance("effect bridges retain captured snapshots while deferred callbacks run", () => Effect.gen(function* () {
+  const ready = yield* Deferred.make<void>()
+  const finish = yield* Deferred.make<void>()
+  const old = yield* RuntimeConfig.current
+  const bridge = yield* RuntimeConfig.use(EffectBridge.make())
+  const callback = yield* bridge.run(Effect.gen(function* () {
+    expect(yield* RuntimeConfig.current).toBe(old)
+    yield* Deferred.succeed(ready, undefined)
+    yield* Deferred.await(finish)
+  })).pipe(Effect.forkScoped)
+  yield* Deferred.await(ready)
+  yield* RuntimeConfig.refresh
+  expect(old.closed).toBe(false)
+  yield* Deferred.succeed(finish, undefined)
+  yield* Fiber.join(callback)
+  expect(old.closed).toBe(true)
+}))
+
+unit.instance("failed and explicitly cancelled runners release their retired snapshots", () => Effect.gen(function* () {
+  const scope = yield* Scope.Scope
+  for (const failure of ["error", "cancel"] as const) {
+    const ready = yield* Deferred.make<RuntimeConfig.Revision>()
+    const finish = yield* Deferred.make<void>()
+    const runner = Runner.make<void, string>(scope, { onInterrupt: Effect.void })
+    const fiber = yield* runner.ensureRunning(Effect.gen(function* () {
+      yield* Deferred.succeed(ready, yield* RuntimeConfig.current)
+      yield* Deferred.await(finish)
+      return yield* Effect.fail("expected")
+    })).pipe(Effect.exit, Effect.forkScoped)
+    const old = yield* Deferred.await(ready)
+    yield* RuntimeConfig.refresh
+    expect(old.closed).toBe(false)
+    if (failure === "cancel") yield* runner.cancel
+    else yield* Deferred.succeed(finish, undefined)
+    const exit = yield* Fiber.join(fiber)
+    expect(Exit.isSuccess(exit)).toBe(failure === "cancel")
+    expect(old.closed).toBe(true)
+  }
+}))
+
+unit.instance("forking into a closed scope does not leak the retained snapshot", () => Effect.gen(function* () {
+  const scope = yield* Scope.make()
+  yield* Scope.close(scope, Exit.void)
+  const old = yield* RuntimeConfig.current
+  const fiber = yield* Effect.void.pipe(RuntimeConfig.forkIn(scope))
+  yield* Fiber.await(fiber)
+  yield* RuntimeConfig.refresh
+  expect(old.readers).toBe(0)
+  expect(old.closed).toBe(true)
+}))
