{
    "name": "drift",
    "version": "2.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun scripts/dev.ts",
        "dev:ui": "vite",
        "dev:shell": "tauri dev --no-watch -c src-tauri/dev.conf.json",
        "build": "vite build",
        "build:tauri": "bun run build",
        "build:whisper": "bun scripts/build-whisper.ts",
        "gen:engine": "bun scripts/gen-engine-client.ts",
        "bench:engine": "bun scripts/bench-engine.ts",
        "build:native": "bun scripts/release-policy.ts stamp-dev && tauri build --no-bundle",
        "package": "bun scripts/release-policy.ts stamp-dev && tauri build",
        "gates": "bun scripts/gates.ts",
        "test": "bun test --parallel=8 tests",
        "test:conformance": "bun test tests/conformance",
        "test:release-policy": "bun test tests/release-policy.test.ts",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write . && cargo fmt --all",
        "format:check": "prettier --check . && cargo fmt --all --check",
        "lint": "eslint",
        "knip": "knip --no-progress"
    },
    "dependencies": {
        "dompurify": "^3.2.4",
        "linguist-languages": "9.4.0",
        "marked": "^15.0.7",
        "pdfjs-dist": "^6.2.108",
        "shiki": "^3.2.1",
        "solid-js": "^1.9.5",
        "three": "^0.185.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.3",
        "@tauri-apps/cli": "2.11.4",
        "@types/node": "24.12.2",
        "@types/three": "^0.185.1",
        "eslint": "^10.12.0",
        "eslint-plugin-perfectionist": "^5.12.1",
        "eslint-plugin-solid": "^0.18.1",
        "knip": "^6.40.0",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.1.3",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.71.1",
        "vite": "^6.2.5",
        "vite-plugin-solid": "^2.11.6"
    }
}
