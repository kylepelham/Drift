{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "roc",
    "scopeName": "source.roc",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#characters" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#definitions" },
        { "include": "#operators" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                { "name": "comment.line.documentation.roc", "match": "##.*$" },
                { "name": "comment.line.number-sign.roc", "match": "#.*$" }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.triple.roc",
                    "begin": "\"\"\"",
                    "end": "\"\"\"",
                    "patterns": [{ "include": "#escapes" }, { "include": "#interpolation" }]
                },
                {
                    "name": "string.quoted.double.roc",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [{ "include": "#escapes" }, { "include": "#interpolation" }]
                }
            ]
        },
        "escapes": {
            "name": "constant.character.escape.roc",
            "match": "\\\\(?:[nrt\"'\\\\$]|u\\([0-9A-Fa-f]{1,6}\\))"
        },
        "interpolation": {
            "name": "meta.interpolation.roc",
            "begin": "(?:\\$|\\\\)\\(",
            "end": "\\)",
            "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.roc" } },
            "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.roc" } },
            "patterns": [{ "include": "$self" }]
        },
        "characters": {
            "name": "string.quoted.single.roc",
            "match": "'(?:\\\\.|[^'\\\\])'"
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.roc",
                    "match": "\\b0x[0-9A-Fa-f_]+(?:[iu](?:8|16|32|64|128))?\\b"
                },
                {
                    "name": "constant.numeric.binary.roc",
                    "match": "\\b0b[01_]+(?:[iu](?:8|16|32|64|128))?\\b"
                },
                {
                    "name": "constant.numeric.roc",
                    "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:e[+-]?[0-9]+)?(?:[iu](?:8|16|32|64|128)|f32|f64|dec)?\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.roc",
                    "match": "\\b(?:if|then|else|when|is|expect|dbg|crash|return|for|in|while|break|continue|var)\\b"
                },
                {
                    "name": "keyword.other.roc",
                    "match": "\\b(?:app|module|package|platform|interface|hosted|import|imports|exposing|exposes|provides|requires|packages|generates|with|as|to|implements|where)\\b"
                }
            ]
        },
        "types": {
            "name": "entity.name.type.roc",
            "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        "definitions": {
            "match": "^\\s*([a-z_][A-Za-z0-9_]*!?)\\s*(?=:|=(?!=))",
            "captures": { "1": { "name": "entity.name.function.roc" } }
        },
        "operators": {
            "patterns": [
                { "name": "keyword.operator.arrow.roc", "match": "->|<-|=>|\\|>" },
                {
                    "name": "keyword.operator.roc",
                    "match": "==|!=|<=|>=|&&|\\|\\||//|\\^|[-+*/%<>=?!&|\\\\]"
                }
            ]
        }
    }
}
