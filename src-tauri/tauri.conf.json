{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drift",
  "version": "0.1.0",
  "identifier": "dev.drift.app",
  "build": {
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Drift",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": { "nsis": { "compression": "zlib" } },
    "externalBin": ["binaries/drift-engine"],
    "resources": {
      "../engine/opencode/opencode.json": "drift-extensions/opencode.json",
      "../engine/opencode/package.json": "drift-extensions/package.json",
      "../engine/opencode/plugin/": "drift-extensions/plugin/"
    }
  }
}
